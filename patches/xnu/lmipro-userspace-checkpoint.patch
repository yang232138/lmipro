+/* Read-only bring-up state; separate from the successful Data mount state. */
+#if defined(XNU_OWNER_CACHE_MOUNT) && XNU_OWNER_CACHE_MOUNT
+volatile int lmipro_init_stage = 0;
+volatile int lmipro_init_error = -1;
+char lmipro_init_path[128];
+#endif
+
 static int
 load_init_program_at_path(proc_t p, user_addr_t scratch_addr, const char* path, user_addr_t envp)
 {
@@ -8166,6 +8173,11 @@
 	assert(p);
 	assert(scratch_addr);
 	assert(path);
+#if defined(XNU_OWNER_CACHE_MOUNT) && XNU_OWNER_CACHE_MOUNT
+	lmipro_init_stage = 20; /* Preparing the original init exec arguments. */
+	lmipro_init_error = -1;
+	strlcpy(lmipro_init_path, path, sizeof(lmipro_init_path));
+#endif
 
 	/*
 	 * Copy out program name.
@@ -8235,7 +8247,15 @@
 	 */
