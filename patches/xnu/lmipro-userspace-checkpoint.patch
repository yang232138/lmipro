+#if defined(XNU_OWNER_CACHE_MOUNT) && XNU_OWNER_CACHE_MOUNT
+	lmipro_init_error = error;
+	lmipro_init_stage = 22; /* Original execve actually returned. */
+#endif
+	return error;
 }
 
