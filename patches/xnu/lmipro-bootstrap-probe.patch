+unsigned lmipro_bootstrap_report(char *, unsigned);
+__attribute__((noinline)) unsigned
+lmipro_bootstrap_report(char *out, unsigned cap)
+{
+	if (!out || !cap) {
+		return 0;
+	}
+	out[0] = 0;
+	const unsigned config = lmb_setting();
+	if (config <= 1) {
+		return 0;
+	}
+	if (!__sync_bool_compare_and_swap(&lmb_guard, 0, 1)) {
+		return (unsigned)snprintf(out, cap, "SB lookup/v3 snapshot busy\n");
+	}
+	struct lmb_record row = lmb_snapshot;
+	__sync_lock_release(&lmb_guard);
+	int run_state = -1;
+	if (row.phase == LMB_ENTERED || row.disp == LMD_ENTERED) {
+		thread_t th = lmipro_bootstrap_report_thread(row.pid, row.tid);
+		if (th != THREAD_NULL) {
+			thread_basic_info_data_t basic = {};
+			mach_msg_type_number_t n = THREAD_BASIC_INFO_COUNT;
+			if (thread_info_internal(th, THREAD_BASIC_INFO, (thread_info_t)&basic, &n) == KERN_SUCCESS) {
+				run_state = basic.run_state;
+			}
+			thread_deallocate(th);
+		}
+	}
+	/* If the wrapper returned during the task/thread lookup, prefer its
+	 * paired return over combining a stale open row with a new run state. */
+	if ((row.phase == LMB_ENTERED || row.disp == LMD_ENTERED) &&
+	    __sync_bool_compare_and_swap(&lmb_guard, 0, 1)) {
+		if (lmb_snapshot.phase != row.phase || lmb_snapshot.mach_in != row.mach_in ||
+		    lmb_snapshot.mach_out != row.mach_out || lmb_snapshot.disp != row.disp ||
+		    lmb_snapshot.disp_mach_in != row.disp_mach_in || lmb_snapshot.disp_mach_out != row.disp_mach_out) {
+			row = lmb_snapshot;
+			run_state = -1;
+		}
+		__sync_lock_release(&lmb_guard);
+	}
+	if (row.disp != LMD_OFF) {
+		uint64_t age = 0;
+		if (row.disp_mach_in) {
+			absolutetime_to_nanoseconds((row.disp_mach_out ? row.disp_mach_out : mach_absolute_time()) -
+			    row.disp_mach_in, &age);
+		}
+		return (unsigned)snprintf(out, cap,
+		    "BKS screen/v1 p%d t%llu bootRet%d port%x state%u diag%u\n"
+		    "id6001011 at%llu trap%u/%u/%x ageMs%llu run%d msg%u/%x ret%u/%d\n"
+		    "out%u %x/%x/%x/%x flags%x/%x upper%llx cache%llx main%llx\n",
+		    row.pid, (unsigned long long)row.tid, row.result, row.port, row.disp, row.disp_diag,
+		    (unsigned long long)row.disp_at, (unsigned)(row.disp_mach_in != 0),
+		    (unsigned)(row.disp_mach_out != 0), (unsigned)row.disp_trap_status,
+		    (unsigned long long)(age / UINT64_C(1000000)), run_state, row.disp_mach_ret,
+		    (unsigned)row.disp_transport, (unsigned)(row.disp == LMD_RETURNED), row.disp_result,
+		    row.disp_output, row.disp_words[0], row.disp_words[1], row.disp_words[2], row.disp_words[3],
+		    (unsigned)row.disp_flags[0], (unsigned)row.disp_flags[1], (unsigned long long)row.disp_upper,
+		    (unsigned long long)(LMB_CACHE + row.slide), (unsigned long long)row.main_base);
+	}
+	uint64_t ms = 0, mms = 0;
+	if (row.enter) {
+		absolutetime_to_nanoseconds((row.end ? row.end : mach_absolute_time()) - row.enter, &ms);
+	}
+	if (row.mach_in) {
+		absolutetime_to_nanoseconds((row.mach_out ? row.mach_out : mach_absolute_time()) - row.mach_in, &mms);
+	}
+	return (unsigned)snprintf(out, cap,
+	    "SB lookup/v3 from%u phase%u diag%d p%d t%llu lost%u\n"
+	    "name=%s err%u ret%u/%d store%u port%u/%x\n"
+	    "lr=%llx parent=%llx main=%llx cache=%llx xpc=%llx\n"
+	    "at=%llu ticks=%llx ageMs=%llu run=%d mach=%u/%u/%x ageMs=%llu\n"
+	    "ready=%llu checks=%u depth=%u\n",
+	    config - 2, row.phase, row.diagnostic, row.pid, (unsigned long long)row.tid,
+	    __atomic_load_n(&lmb_lost, __ATOMIC_RELAXED), row.name[0] ? row.name : "?", row.name_error,
+	    (unsigned)(row.phase == LMB_RETURNED), row.result, row.stored, row.port_check, row.port,
+	    (unsigned long long)row.caller, (unsigned long long)row.parent, (unsigned long long)row.main_base,
+	    row.phase ? (unsigned long long)(LMB_CACHE + row.slide) : 0ULL,
+	    row.phase ? (unsigned long long)(LMB_XPC + row.slide) : 0ULL,
+	    (unsigned long long)row.at_seconds, (unsigned long long)row.enter, (unsigned long long)(ms / UINT64_C(1000000)), run_state,
+	    (unsigned)(row.mach_in != 0), (unsigned)(row.mach_out != 0), (unsigned)row.mach_status, (unsigned long long)(mms / UINT64_C(1000000)),
+	    (unsigned long long)row.ready_seconds, row.chain_checked, row.chain_depth);
+}
