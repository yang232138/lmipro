diff --git a/osfmk/arm64/lmipro_bootstrap_probe.h b/osfmk/arm64/lmipro_bootstrap_probe.h
new file mode 100644
--- /dev/null
+++ b/osfmk/arm64/lmipro_bootstrap_probe.h
@@ -0,0 +1,532 @@
+/* Opt-in one-shot lookup probe for the pinned 21H461 ARM64 cache.
+ * Uses the existing XNU per-thread debug state machinery. No writes to EL0
+ * memory, changes to saved registers, debug entitlements, or IPC semantics. */
+#define LMB_ENTRY UINT64_C(0x1dd67d1c4)
+#define LMB_STORE UINT64_C(0x1dd67cb70)
+#define LMB_RET   UINT64_C(0x1dd67d214)
+#define LMB_MACH2 UINT64_C(0x1cb780b58)
+#define LMB_CACHE UINT64_C(0x180000000)
+#define LMB_XPC   UINT64_C(0x1dd666000)
+#define LMD_ENTRY UINT64_C(0x18f65cc08)
+#define LMD_LR    UINT64_C(0x18f65cb98)
+#define LMD_MACH  UINT64_C(0x18f65ccac)
+#define LMD_RET   UINT64_C(0x18f65cdb8)
+#define LMD_ID    UINT64_C(6001011)
+#define LMB_BCR   (ARM_DBG_CR_BYTE_ADDRESS_SELECT_MASK | ARM_DBG_CR_ENABLE_ENABLE)
+
+static const uint8_t lmb_uuid[16] = {
+	0x59,0x0d,0x83,0x9a,0x82,0xd2,0x30,0xf1,0xa1,0x7d,0x0c,0xc0,0x53,0x42,0x0f,0x73
+};
+enum { LMB_IDLE, LMB_SCANNING, LMB_ENTERED, LMB_RETURNED, LMB_REFUSED, LMB_MISMATCH, LMB_QUALIFYING };
+enum { LMD_OFF, LMD_ARMED, LMD_ENTERED, LMD_RETURNED, LMD_INVALID };
+struct lmb_record {
+	unsigned phase, slide, name_error, port_check, stored, chain_checked, chain_depth;
+	int pid, diagnostic, result, mach_status;
+	uint64_t tid, enter, end, at_seconds, caller, parent, main_base, mach_in, mach_out, ready_seconds;
+	unsigned disp, disp_diag, disp_output, disp_mach_ret;
+	int disp_result, disp_transport, disp_trap_status;
+	uint64_t disp_at, disp_mach_in, disp_mach_out, disp_upper;
+	uint32_t disp_words[4];
+	uint8_t disp_flags[2];
+	mach_port_name_t port;
+	char name[96];
+};
+static struct lmb_record lmb_live, lmb_snapshot;
+static uint64_t lmb_sp, lmb_out, lmd_sp, lmd_trap_sp;
+static mach_port_name_t lmb_expected;
+static arm_debug_state_t *lmb_owner;
+static unsigned lmb_guard, lmb_lost;
+static unsigned lmb_config; /* 0 unparsed, 1 off, otherwise requested sec + 2 */
+
+static unsigned
+lmb_setting(void)
+{
+	unsigned config = __atomic_load_n(&lmb_config, __ATOMIC_ACQUIRE);
+	if (config == 0) {
+		unsigned from = 0;
+		config = PE_parse_boot_argn("lmipro-bootstrap-at", &from, sizeof(from)) &&
+		    from <= 590 ? from + 2 : 1;
+		__atomic_store_n(&lmb_config, config, __ATOMIC_RELEASE);
+	}
+	return config;
+}
+
+static void
+lmb_publish(void)
+{
+	if (!__sync_bool_compare_and_swap(&lmb_guard, 0, 1)) {
+		__atomic_fetch_add(&lmb_lost, 1, __ATOMIC_RELAXED);
+		return;
+	}
+	lmb_snapshot = lmb_live;
+	__sync_lock_release(&lmb_guard);
+}
+
+static bool
+lmb_ptr(uint64_t p, size_t bytes)
+{
+	return p >= 0x1000 && bytes != 0 && p < MACH_VM_MAX_ADDRESS &&
+	    bytes <= MACH_VM_MAX_ADDRESS - p;
+}
+
+static bool
+lmb_word(uint64_t pc, uint32_t expected)
+{
+	uint32_t actual = 0;
+	return lmb_ptr(pc, sizeof(actual)) && copyin((user_addr_t)pc, &actual, sizeof(actual)) == 0 &&
+	    actual == expected;
+}
+
+static kern_return_t
+lmb_set(thread_t th, uint64_t first, uint64_t second)
+{
+	arm_debug_state64_t d = {};
+	if (first) {
+		d.bvr[0] = first;
+		d.bcr[0] = LMB_BCR;
+	}
+	if (second) {
+		d.bvr[1] = second;
+		d.bcr[1] = LMB_BCR;
+	}
+	return machine_thread_set_state(th, ARM_DEBUG_STATE64, (thread_state_t)&d, ARM_DEBUG_STATE64_COUNT);
+}
+
+static bool
+lmb_owned(thread_t th, uint64_t pc)
+{
+	arm_debug_state_t *d = th->machine.DebugData;
+	return lmb_owner != NULL && d == lmb_owner && d->dsh.flavor == ARM_DEBUG_STATE64 &&
+	    (((d->uds.ds64.bcr[0] & ARM_DBG_CR_ENABLE_ENABLE) && d->uds.ds64.bvr[0] == pc) ||
+	    ((d->uds.ds64.bcr[1] & ARM_DBG_CR_ENABLE_ENABLE) && d->uds.ds64.bvr[1] == pc));
+}
+
+static bool
+lmb_can_read(void)
+{
+	return ml_get_interrupts_enabled() && preemption_enabled();
+}
+
+static void
+lmb_name(uint64_t address)
+{
+	char name[sizeof(lmb_live.name)] = {};
+	size_t done = 0;
+	lmb_live.name_error = EFAULT;
+	if (!lmb_ptr(address, sizeof(name))) {
+		return;
+	}
+	lmb_live.name_error = copyinstr((user_addr_t)address, name, sizeof(name), &done);
+	if (lmb_live.name_error) {
+		return;
+	}
+	if (done < 2 || done > sizeof(name) || name[done - 1] != 0) {
+		lmb_live.name_error = EINVAL;
+		return;
+	}
+	for (size_t i = 0; i < done - 1; ++i) {
+		if (name[i] < 0x21 || name[i] > 0x7e) {
+			lmb_live.name_error = EINVAL;
+			return;
+		}
+	}
+	memcpy(lmb_live.name, name, done);
+}
+
+extern int proc_selfpid(void);
+extern void proc_selfname(char *, int);
+extern uint64_t lmipro_ui_stack_seconds(void);
+bool lmipro_bootstrap_debug_allowed(void);
+thread_t lmipro_bootstrap_report_thread(int, uint64_t);
+
+/* Recover only the exact already-observed 21H461 wrapper chain at its Mach
+ * trap. The frame of __xpc_interface_routine saves the lookup's x19 (name)
+ * at FP-8 and x23 (output pointer) at FP-40. Breakpoints are installed
+ * only after recovering this exact chain, to observe store and return. */
+static bool
+lmb_inflight(thread_t th, const arm_saved_state_t *ss)
+{
+	static const uint64_t returns[] = {
+		0x1cb7841b0, 0x1cb783fb8, 0x1dd68b7ec, 0x1dd68ac9c,
+		0x1dd669a90, 0x1dd67cb20, 0x1dd67d1f4,
+	};
+	const uint64_t slide = lmb_live.slide;
+	if (get_saved_state_pc(ss) != LMB_MACH2 + slide || !lmb_can_read()) {
+		return false;
+	}
+	uint64_t fp = get_saved_state_fp(ss), sp = get_saved_state_sp(ss);
+	uint64_t frame[2], slots[5], xpc_fp = 0;
+	for (unsigned i = 0; i < sizeof(returns) / sizeof(returns[0]); ++i) {
+		if ((fp & 15) || !lmb_ptr(fp, sizeof(frame)) || fp < sp || fp - sp > 0x8000 ||
+		    copyin((user_addr_t)fp, frame, sizeof(frame)) != 0 || frame[1] != returns[i] + slide ||
+		    frame[0] <= fp) {
+			return false;
+		}
+		if (lmb_live.chain_depth < i + 1) {
+			lmb_live.chain_depth = i + 1;
+		}
+		if (i == 5) {
+			xpc_fp = fp;
+			if (frame[0] - fp != 0x60) {
+				return false;
+			}
+		} else if (i == 6 && frame[0] - fp != 0x30) {
+			return false;
+		}
+		fp = frame[0];
+	}
+	if (!lmb_ptr(fp, sizeof(frame)) || fp - sp > 0x8000 ||
+	    copyin((user_addr_t)fp, frame, sizeof(frame)) != 0 || (frame[1] & 3) ||
+	    !lmb_ptr(frame[1], sizeof(uint32_t)) || !lmb_ptr(xpc_fp - sizeof(slots), sizeof(slots)) ||
+	    !lmb_word(0x1dd6699d0 + slide, 0xa9045ff8) || !lmb_word(0x1dd6699d8 + slide, 0xa9064ff4) ||
+	    copyin((user_addr_t)(xpc_fp - sizeof(slots)), slots, sizeof(slots)) != 0) {
+		return false;
+	}
+	lmb_sp = fp + sizeof(frame);
+	lmb_out = slots[0];
+	lmb_live.caller = frame[1];
+	lmb_live.enter = lmb_live.mach_in = mach_absolute_time();
+	lmb_live.at_seconds = lmipro_ui_stack_seconds();
+	lmb_name(slots[4]);
+	if (!(frame[0] & 15) && frame[0] > fp && frame[0] - fp <= 0x8000 &&
+	    lmb_ptr(frame[0], sizeof(frame)) && copyin((user_addr_t)frame[0], frame, sizeof(frame)) == 0 &&
+	    !(frame[1] & 3) && lmb_ptr(frame[1], sizeof(uint32_t))) {
+		lmb_live.parent = frame[1];
+	}
+	int status = 0;
+	if (!lmipro_bootstrap_debug_allowed() || th->machine.DebugData) {
+		status = EPERM;
+	} else if (arm_debug_info()->num_breakpoint_pairs < 2) {
+		status = ENOTSUP;
+	} else {
+		status = lmb_set(th, LMB_RET + slide, LMB_STORE + slide);
+		lmb_owner = th->machine.DebugData;
+		if (!status && (!lmb_owned(th, LMB_RET + slide) || !lmb_owned(th, LMB_STORE + slide))) {
+			status = EIO;
+		}
+		if (status && lmb_owner != NULL) {
+			(void)lmb_set(th, 0, 0);
+			lmb_owner = NULL;
+		}
+	}
+	lmb_live.diagnostic = status;
+	__atomic_store_n(&lmb_live.phase, status ? LMB_REFUSED : LMB_ENTERED, __ATOMIC_RELEASE);
+	lmb_publish();
+	return true;
+}
+
+static __attribute__((noinline)) void
+lmipro_bootstrap_svc(thread_t th, arm_saved_state_t *ss, int trap, bool returning)
+{
+	const unsigned config = lmb_setting();
+	if (config <= 1 || !(thread_get_tag(th) & THREAD_TAG_MAINTHREAD)) {
+		return;
+	}
+	unsigned phase = __atomic_load_n(&lmb_live.phase, __ATOMIC_ACQUIRE);
+	if (phase == LMB_RETURNED && lmb_live.disp == LMD_ENTERED && trap == -47 &&
+	    lmb_live.tid == thread_tid(th) && get_saved_state_pc(ss) == LMB_MACH2 + lmb_live.slide) {
+		const uint64_t *x = const_saved_state64(ss)->x;
+		if (!returning && (x[1] & 3) == 3 && (uint32_t)x[3] == lmb_live.port &&
+		    x[4] >> 32 == LMD_ID) {
+			lmd_trap_sp = get_saved_state_sp(ss);
+			lmb_live.disp_mach_in = mach_absolute_time();
+			lmb_live.disp_mach_out = 0;
+		} else if (returning && lmb_live.disp_mach_in && !lmb_live.disp_mach_out &&
+		    lmd_trap_sp == get_saved_state_sp(ss)) {
+			lmb_live.disp_mach_out = mach_absolute_time();
+			lmb_live.disp_trap_status = (int)x[0];
+		} else {
+			return;
+		}
+		lmb_publish();
+		return;
+	}
+	if (phase == LMB_ENTERED) {
+		if (trap == -47 && lmb_live.tid == thread_tid(th) &&
+		    get_saved_state_pc(ss) == LMB_MACH2 + lmb_live.slide) {
+			if (!returning) {
+				lmb_live.mach_in = mach_absolute_time();
+				lmb_live.mach_out = 0;
+			} else if (lmb_live.mach_in && !lmb_live.mach_out) {
+				lmb_live.mach_out = mach_absolute_time();
+				lmb_live.mach_status = (int)const_saved_state64(ss)->x[0];
+			}
+			lmb_publish();
+		}
+		return;
+	}
+	if (phase == LMB_SCANNING && !returning && trap == -47 && lmb_live.tid == thread_tid(th) &&
+	    get_saved_state_pc(ss) == LMB_MACH2 + lmb_live.slide && lmb_can_read() &&
+	    lmb_live.chain_checked < 4096) {
+		++lmb_live.chain_checked;
+		if (!lmb_inflight(th, ss)) {
+			lmb_publish();
+		}
+		return;
+	}
+	if (returning || trap != -47 || phase != LMB_IDLE || !lmb_can_read() ||
+	    lmipro_ui_stack_seconds() < config - 2) {
+		return;
+	}
+	char name[17] = {};
+	proc_selfname(name, sizeof(name));
+	if (strcmp(name, "SpringBoard")) {
+		return;
+	}
+	task_t task = current_task();
+	uint32_t slide = task->task_shared_region_slide;
+	if (slide == UINT32_MAX || get_saved_state_pc(ss) != LMB_MACH2 + slide) {
+		return; /* dyld has not published the cache yet */
+	}
+	unsigned idle = LMB_IDLE;
+	if (!__atomic_compare_exchange_n(&lmb_live.phase, &idle, LMB_QUALIFYING, false,
+	    __ATOMIC_ACQ_REL, __ATOMIC_RELAXED)) {
+		return;
+	}
+	lmb_live.pid = proc_selfpid();
+	lmb_live.tid = thread_tid(th);
+	lmb_live.slide = slide;
+	lmb_live.main_base = task->mach_header_vm_address;
+	lmb_live.ready_seconds = lmipro_ui_stack_seconds();
+	int status = 0;
+	if (memcmp(task->task_shared_region_uuid, lmb_uuid, sizeof(lmb_uuid)) ||
+	    (slide & 0xfff) || !lmb_word(LMB_ENTRY + slide, 0xd100c3ff) ||
+	    !lmb_word(LMB_STORE + slide, 0xb90002f9) || !lmb_word(LMB_RET + slide, 0xd65f03c0)) {
+		status = ENOEXEC;
+	}
+	lmb_live.diagnostic = status;
+	__atomic_store_n(&lmb_live.phase, status ? LMB_REFUSED : LMB_SCANNING, __ATOMIC_RELEASE);
+	if (!status) {
+		++lmb_live.chain_checked;
+		if (lmb_inflight(th, ss)) {
+			return;
+		}
+	}
+	lmb_publish();
+}
+
+/* Follow only the screen-info call immediately after the proven lookup.
+ * At the MIG return, the caller's six real output slots are still live. */
+static bool
+lmd_break(thread_t th, const arm_saved_state_t *ss)
+{
+	const uint64_t slide = lmb_live.slide, pc = get_saved_state_pc(ss);
+	const uint64_t lr = get_saved_state_lr(ss), sp = get_saved_state_sp(ss);
+	const uint64_t *x = const_saved_state64(ss)->x;
+	if (lmb_live.disp == LMD_ARMED && pc == LMD_ENTRY + slide && lr == LMD_LR + slide &&
+	    lmb_can_read() && !(sp & 15) && lmb_ptr(sp, 0x60) && (uint32_t)x[0] == lmb_live.port &&
+	    x[1] == sp + 0x1c && x[2] == sp + 0x18 && x[3] == sp + 0x14 &&
+	    x[4] == sp + 0x10 && x[5] == sp + 0xf && x[6] == sp + 0xe) {
+		uint64_t upper = 0;
+		if (get_saved_state_fp(ss) == sp + 0x50 &&
+		    copyin((user_addr_t)(sp + 0x58), &upper, sizeof(upper)) == 0 &&
+		    !(upper & 3) && lmb_ptr(upper, sizeof(uint32_t))) {
+			lmb_live.disp_upper = upper;
+		}
+		lmd_sp = sp;
+		lmb_live.disp_at = lmipro_ui_stack_seconds();
+		lmb_live.disp_diag = lmb_set(th, LMD_MACH + slide, LMD_RET + slide);
+		if (!lmb_live.disp_diag) {
+			lmb_live.disp = LMD_ENTERED;
+			lmb_publish();
+			return true;
+		}
+	} else if (lmb_live.disp == LMD_ENTERED && pc == LMD_MACH + slide &&
+	    lmd_sp >= 0xa0 && sp == lmd_sp - 0xa0) {
+		lmb_live.disp_transport = (int)x[0];
+		lmb_live.disp_mach_ret = 1;
+		lmb_live.disp_diag = lmb_set(th, LMD_RET + slide, 0);
+		if (!lmb_live.disp_diag) {
+			lmb_publish();
+			return true;
+		}
+	} else if (lmb_live.disp == LMD_ENTERED && pc == LMD_RET + slide &&
+	    lr == LMD_LR + slide && sp == lmd_sp && lmb_can_read()) {
+		lmb_live.disp_result = (int)x[0];
+		if (!lmb_live.disp_result) {
+			uint8_t buf[18] = {};
+			if (copyin((user_addr_t)(sp + 0xe), buf, sizeof(buf)) == 0) {
+				for (unsigned i = 0; i < 4; ++i) {
+					memcpy(&lmb_live.disp_words[i], buf + 14 - 4 * i, sizeof(uint32_t));
+				}
+				lmb_live.disp_flags[0] = buf[1];
+				lmb_live.disp_flags[1] = buf[0];
+				lmb_live.disp_output = 1;
+			}
+		}
+		lmb_live.disp_diag = lmb_set(th, 0, 0);
+		lmb_owner = NULL;
+		lmb_live.disp = LMD_RETURNED;
+		lmb_publish();
+		return true;
+	}
+	(void)lmb_set(th, 0, 0);
+	lmb_owner = NULL;
+	lmb_live.disp = LMD_INVALID;
+	lmb_publish();
+	return true;
+}
+
+static __attribute__((noinline)) bool
+lmipro_bootstrap_break(thread_t th, const arm_saved_state_t *ss)
+{
+	const uint64_t pc = get_saved_state_pc(ss);
+	unsigned phase = __atomic_load_n(&lmb_live.phase, __ATOMIC_ACQUIRE);
+	if (lmb_live.tid != thread_tid(th) || !lmb_owned(th, pc)) {
+		return false;
+	}
+	if (phase == LMB_RETURNED && (lmb_live.disp == LMD_ARMED || lmb_live.disp == LMD_ENTERED)) {
+		return lmd_break(th, ss);
+	}
+	if (phase != LMB_ENTERED) {
+		return false;
+	}
+	const uint64_t slide = lmb_live.slide;
+	const uint64_t caller = get_saved_state_lr(ss);
+	const uint64_t sp = get_saved_state_sp(ss);
+	const uint64_t *regs = const_saved_state64(ss)->x;
+	if (pc == LMB_STORE + slide && lmb_can_read() &&
+	    lmb_sp >= 0x90 && sp == lmb_sp - 0x90 && regs[23] == lmb_out) {
+		/* The next instruction is the original _bootstrap_look_up3 store.
+		 * Disable this breakpoint before letting that instruction run. */
+		lmb_live.stored = 1;
+		lmb_expected = (mach_port_name_t)regs[25];
+		lmb_live.diagnostic = lmb_set(th, LMB_RET + slide, 0);
+		if (!lmb_live.diagnostic) {
+			lmb_publish();
+			return true;
+		}
+	} else if (phase == LMB_ENTERED && pc == LMB_RET + slide && lmb_sp == sp &&
+	    caller == lmb_live.caller && lmb_can_read()) {
+		lmb_live.end = mach_absolute_time();
+		lmb_live.result = (kern_return_t)regs[0];
+		if (lmb_live.result == KERN_SUCCESS && lmb_live.stored) {
+			mach_port_name_t port = MACH_PORT_NULL;
+			mach_port_type_t type = 0;
+			lmb_live.port_check = 1; /* store seen, no validated right yet */
+			if (!(lmb_out & 3) && lmb_ptr(lmb_out, sizeof(port)) &&
+			    copyin((user_addr_t)lmb_out, &port, sizeof(port)) == 0 && port == lmb_expected &&
+			    MACH_PORT_VALID(port) &&
+			    mach_port_type(current_task()->itk_space, port, &type) == KERN_SUCCESS &&
+			    (type & MACH_PORT_TYPE_SEND)) {
+				lmb_live.port_check = 2;
+				lmb_live.port = port;
+			}
+		}
+		if (lmb_live.port_check == 2 && lmb_live.caller == 0x18f65d674 + slide &&
+		    lmb_live.parent == 0x18f65cb7c + slide &&
+		    !strcmp(lmb_live.name, "com.apple.backboard.display.services")) {
+			if (lmb_word(LMD_ENTRY + slide, 0xd10283ff) && lmb_word(LMD_MACH + slide, 0xaa0003f3) &&
+			    lmb_word(LMD_RET + slide, 0xd65f03c0)) {
+				lmb_live.disp_diag = lmb_set(th, LMD_ENTRY + slide, 0);
+				if (!lmb_live.disp_diag && lmb_owned(th, LMD_ENTRY + slide)) {
+					lmb_live.disp = LMD_ARMED;
+				}
+			} else {
+				lmb_live.disp_diag = ENOEXEC;
+			}
+			if (lmb_live.disp != LMD_ARMED) {
+				lmb_live.disp = LMD_INVALID;
+			}
+		}
+		if (lmb_live.disp != LMD_ARMED) {
+			lmb_live.diagnostic = lmb_set(th, 0, 0);
+			lmb_owner = NULL;
+		}
+		__atomic_store_n(&lmb_live.phase, LMB_RETURNED, __ATOMIC_RELEASE);
+		lmb_publish();
+		return true;
+	}
+	/* Do not repeatedly trap on our instruction if an ABI/call-pair check
+	 * fails. Let the original instruction execute, and mark the sample invalid. */
+	(void)lmb_set(th, 0, 0);
+	lmb_owner = NULL;
+	__atomic_store_n(&lmb_live.phase, LMB_MISMATCH, __ATOMIC_RELEASE);
+	lmb_publish();
+	return true;
+}
