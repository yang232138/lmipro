diff --git a/osfmk/arm64/lmipro_bootstrap_probe.h b/osfmk/arm64/lmipro_bootstrap_probe.h
new file mode 100644
--- /dev/null
+++ b/osfmk/arm64/lmipro_bootstrap_probe.h
@@ -0,0 +1,1042 @@
+/* Opt-in one-shot lookup probe for the pinned 21H461 ARM64 cache.
+ * Uses the existing XNU per-thread debug state machinery. No writes to EL0
+ * memory, changes to saved registers, debug entitlements, or IPC semantics. */
+#define LMB_ENTRY UINT64_C(0x1dd67d1c4)
+#define LMB_STORE UINT64_C(0x1dd67cb70)
+#define LMB_RET   UINT64_C(0x1dd67d214)
+#define LMB_MACH2 UINT64_C(0x1cb780b58)
+#define LMB_CACHE UINT64_C(0x180000000)
+#define LMB_XPC   UINT64_C(0x1dd666000)
+#define LMD_ENTRY UINT64_C(0x18f65cc08)
+#define LMD_LR    UINT64_C(0x18f65cb98)
+#define LMD_MACH  UINT64_C(0x18f65ccac)
+#define LMD_RET   UINT64_C(0x18f65cdb8)
+#define LMD_ID    UINT64_C(6001011)
+#define LMS_TRAP  UINT64_C(0x1cb780a14)
+#define LMS_XPC   UINT64_C(0x187cd3cc4)
+#define LMS_STORE UINT64_C(0x187c8d2d4)
+#define LMS_DB    UINT64_C(0x187c8d2f0)
+#define LMB_BCR   (ARM_DBG_CR_BYTE_ADDRESS_SELECT_MASK | ARM_DBG_CR_ENABLE_ENABLE)
+
+static const uint8_t lmb_uuid[16] = {
+	0x59,0x0d,0x83,0x9a,0x82,0xd2,0x30,0xf1,0xa1,0x7d,0x0c,0xc0,0x53,0x42,0x0f,0x73
+};
+enum { LMB_IDLE, LMB_SCANNING, LMB_ENTERED, LMB_RETURNED, LMB_REFUSED, LMB_MISMATCH, LMB_QUALIFYING };
+enum { LMD_OFF, LMD_ARMED, LMD_ENTERED, LMD_RETURNED, LMD_INVALID };
+struct lmb_record {
+	unsigned phase, slide, name_error, port_check, stored, chain_checked, chain_depth;
+	int pid, diagnostic, result, mach_status;
+	uint64_t tid, enter, end, at_seconds, caller, parent, main_base, mach_in, mach_out, ready_seconds;
+	unsigned disp, disp_diag, disp_output, disp_mach_ret;
+	int disp_result, disp_transport, disp_trap_status;
+	uint64_t disp_at, disp_mach_in, disp_mach_out, disp_upper;
+	uint32_t disp_words[4];
+	uint8_t disp_flags[2];
+	unsigned ui_armed, ui_step, ui_diag, ui_start_result, shell_object;
+	uint64_t ui_caller, ui_at, shell_parent, shell_init_lr;
+	unsigned ls_stage, ls_trap_returned, ls_xpc, ls_store, ls_db;
+	int ls_diag, ls_trap_result;
+	uint64_t ls_at, ls_last;
+	mach_port_name_t port;
+	char name[96];
+};
+static struct lmb_record lmb_live, lmb_snapshot;
+/* Unslid UIKitCore checkpoints, in order in __UIApplicationMainPreparations. */
+struct lmu_site { uint64_t pc; uint32_t op; };
+static const struct lmu_site lmu_sites[] = {
+	{ UINT64_C(0x18a3ba7e4), 0x52801b14 }, /* BKSDisplayServicesStart returned */
+	{ UINT64_C(0x18a3ba81c), 0x94db417b }, /* preload initialization returned */
+	{ UINT64_C(0x18a3ba838), 0x94db4174 }, /* initial display context preload returned */
+	{ UINT64_C(0x18a3ba854), 0x94db416d }, /* initial device context preload returned */
+	{ UINT64_C(0x18a3ba85c), 0x94db41b3 }, /* UIApplicationInitialize returned */
+	{ UINT64_C(0x18a3ba9c4), 0x9453742f }, /* window server start call site */
+	{ UINT64_C(0x18a3ba9c8), 0xaa1603e0 }, /* window server method returned */
+	{ UINT64_C(0x18a3baa28), 0x903528ba }, /* application singleton returned */
+};
+#define LMU_COUNT (sizeof(lmu_sites) / sizeof(lmu_sites[0]))
+/* BKSDisplayServicesStart, shell activation, then the shell initializer. */
+static const struct lmu_site lmu_shell_sites[] = {
+	{ UINT64_C(0x18f692bb8), 0xaa1903e0 },
+	{ UINT64_C(0x18f692c94), 0xd65f03c0 },
+	{ UINT64_C(0x18f691f28), 0xd65f03c0 },
+};
+#define LMU_SHELL_ACTIVATION_COUNT 2
+#define LMU_SHELL_COUNT (sizeof(lmu_shell_sites) / sizeof(lmu_shell_sites[0]))
+static uint64_t lmb_sp, lmb_out, lmd_sp, lmd_trap_sp, lmu_sp;
+static uint64_t lms_trap_sp;
+static mach_port_name_t lmb_expected;
+static arm_debug_state_t *lmb_owner;
+static unsigned lmb_guard, lmb_lost;
+static unsigned lmb_config; /* 0 unparsed, 1 off, otherwise requested sec + 2 */
+
+static unsigned
+lmb_setting(void)
+{
+	unsigned config = __atomic_load_n(&lmb_config, __ATOMIC_ACQUIRE);
+	if (config == 0) {
+		unsigned from = 0;
+		config = PE_parse_boot_argn("lmipro-bootstrap-at", &from, sizeof(from)) &&
+		    from <= 590 ? from + 2 : 1;
+		__atomic_store_n(&lmb_config, config, __ATOMIC_RELEASE);
+	}
+	return config;
+}
+
+static void
+lmb_publish(void)
+{
+	if (!__sync_bool_compare_and_swap(&lmb_guard, 0, 1)) {
+		__atomic_fetch_add(&lmb_lost, 1, __ATOMIC_RELAXED);
+		return;
+	}
+	lmb_snapshot = lmb_live;
+	__sync_lock_release(&lmb_guard);
+}
+
+static bool
+lmb_ptr(uint64_t p, size_t bytes)
+{
+	return p >= 0x1000 && bytes != 0 && p < MACH_VM_MAX_ADDRESS &&
+	    bytes <= MACH_VM_MAX_ADDRESS - p;
+}
+
+static bool
+lmb_word(uint64_t pc, uint32_t expected)
+{
+	uint32_t actual = 0;
+	return lmb_ptr(pc, sizeof(actual)) && copyin((user_addr_t)pc, &actual, sizeof(actual)) == 0 &&
+	    actual == expected;
+}
+
+static kern_return_t
+lmb_set(thread_t th, uint64_t first, uint64_t second)
+{
+	arm_debug_state64_t d = {};
+	if (first) {
+		d.bvr[0] = first;
+		d.bcr[0] = LMB_BCR;
+	}
+	if (second) {
+		d.bvr[1] = second;
+		d.bcr[1] = LMB_BCR;
+	}
+	return machine_thread_set_state(th, ARM_DEBUG_STATE64, (thread_state_t)&d, ARM_DEBUG_STATE64_COUNT);
+}
+
+static bool
+lmb_owned(thread_t th, uint64_t pc)
+{
+	arm_debug_state_t *d = th->machine.DebugData;
+	return lmb_owner != NULL && d == lmb_owner && d->dsh.flavor == ARM_DEBUG_STATE64 &&
+	    (((d->uds.ds64.bcr[0] & ARM_DBG_CR_ENABLE_ENABLE) && d->uds.ds64.bvr[0] == pc) ||
+	    ((d->uds.ds64.bcr[1] & ARM_DBG_CR_ENABLE_ENABLE) && d->uds.ds64.bvr[1] == pc));
+}
+
+static bool
+lmb_can_read(void)
+{
+	return ml_get_interrupts_enabled() && preemption_enabled();
+}
+
+static void
+lmb_name(uint64_t address)
+{
+	char name[sizeof(lmb_live.name)] = {};
+	size_t done = 0;
+	lmb_live.name_error = EFAULT;
+	if (!lmb_ptr(address, sizeof(name))) {
+		return;
+	}
+	lmb_live.name_error = copyinstr((user_addr_t)address, name, sizeof(name), &done);
+	if (lmb_live.name_error) {
+		return;
+	}
+	if (done < 2 || done > sizeof(name) || name[done - 1] != 0) {
+		lmb_live.name_error = EINVAL;
+		return;
+	}
+	for (size_t i = 0; i < done - 1; ++i) {
+		if (name[i] < 0x21 || name[i] > 0x7e) {
+			lmb_live.name_error = EINVAL;
+			return;
+		}
+	}
+	memcpy(lmb_live.name, name, done);
+}
+
+extern int proc_selfpid(void);
+extern void proc_selfname(char *, int);
+extern uint64_t lmipro_ui_stack_seconds(void);
+bool lmipro_bootstrap_debug_allowed(void);
+thread_t lmipro_bootstrap_report_thread(int, uint64_t);
+
+/* Exact 21H461 _SBSystemAppMain call/return pairs. */
+#define LMJ_FB_IN  UINT64_C(0x1a70f830c)
+#define LMJ_FB_OUT UINT64_C(0x1cfa38d60)
+#define LMJ_UI_IN  UINT64_C(0x18a4637d4)
+#define LMJ_UI_OUT UINT64_C(0x1cfa38df4)
+enum { LMJ_NONE, LMJ_ARMED, LMJ_FB_ENTERED, LMJ_FB_RETURNED, LMJ_UI_ENTERED, LMJ_UI_RETURNED };
+struct lmj_record {
+	unsigned sequence, stage, slide, object, argc, pending;
+	int pid, diag, ui_result, trap;
+	uint64_t tid, main, ready, fb_in, fb_out, fb_lr, ui_in, ui_out, ui_lr;
+	uint64_t wait_at, wait_pc, wait_lr, wait_frames[3];
+};
+static struct lmj_record lmj_live, lmj_snapshot;
+static unsigned lmj_config, lmj_claim, lmj_sequence;
+static uint64_t lmj_sp, lmj_fp;
+
+static bool
+lmj_enabled(void)
+{
+	unsigned config = __atomic_load_n(&lmj_config, __ATOMIC_ACQUIRE);
+	if (!config) {
+		unsigned value = 0;
+		config = PE_parse_boot_argn("lmipro-frontboard-boundaries", &value, sizeof(value)) &&
+		    value == 1 ? 2 : 1;
+		__atomic_store_n(&lmj_config, config, __ATOMIC_RELEASE);
+	}
+	return config == 2;
+}
+
+static uint64_t
+lmj_now(void)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / UINT64_C(1000000);
+}
+
+static void
+lmj_publish(void)
+{
+	/* A concurrent reader must never treat a dropped return as a pending call. */
+	lmj_live.sequence = __atomic_add_fetch(&lmj_sequence, 1, __ATOMIC_RELEASE);
+	if (__sync_bool_compare_and_swap(&lmb_guard, 0, 1)) {
+		lmj_snapshot = lmj_live;
+		__sync_lock_release(&lmb_guard);
+	}
+}
+
+static void
+lmj_program(thread_t th, uint64_t pc)
+{
+	arm_debug_state_t *previous = lmb_owner;
+	lmj_live.diag = lmb_set(th, pc, 0);
+	if (lmj_live.diag) {
+		if (previous && th->machine.DebugData == previous) {
+			(void)lmb_set(th, 0, 0);
+		}
+		lmb_owner = NULL;
+		return;
+	}
+	lmb_owner = th->machine.DebugData;
+	if (pc && !lmb_owned(th, pc)) {
+		lmj_live.diag = EIO;
+		(void)lmb_set(th, 0, 0);
+		lmb_owner = NULL;
+	}
+}
+
+static __attribute__((noinline)) void
+lmj_svc(thread_t th, const arm_saved_state_t *ss, int trap, bool returning)
+{
+	if (!(thread_get_tag(th) & THREAD_TAG_MAINTHREAD)) {
+		return;
+	}
+	if (!__atomic_load_n(&lmj_claim, __ATOMIC_ACQUIRE)) {
+		if (!lmb_can_read()) {
+			return;
+		}
+		char name[17] = {};
+		proc_selfname(name, sizeof(name));
+		task_t task = current_task();
+		const uint32_t slide = task->task_shared_region_slide;
+		if (strcmp(name, "SpringBoard") || slide == UINT32_MAX || (slide & 0xfff) ||
+		    memcmp(task->task_shared_region_uuid, lmb_uuid, sizeof(lmb_uuid))) {
+			return;
+		}
+		unsigned empty = 0;
+		if (!__atomic_compare_exchange_n(&lmj_claim, &empty, 1, false,
+		    __ATOMIC_ACQ_REL, __ATOMIC_RELAXED)) {
+			return;
+		}
+		lmj_live.pid = proc_selfpid();
+		lmj_live.tid = thread_tid(th);
+		lmj_live.slide = slide;
+		lmj_live.main = task->mach_header_vm_address;
+		lmj_live.ready = lmj_now();
+		if (!lmipro_bootstrap_debug_allowed() || th->machine.DebugData) {
+			lmj_live.diag = EPERM;
+		} else if (!lmb_word(LMJ_FB_IN + slide, 0xd10303ff) ||
+		    !lmb_word(LMJ_FB_OUT - 4 + slide, 0x95453a0a) ||
+		    !lmb_word(LMJ_FB_OUT + slide, 0xaa1d03fd) ||
+		    !lmb_word(LMJ_UI_IN + slide, 0xd10243ff) ||
+		    !lmb_word(LMJ_UI_OUT - 4 + slide, 0x95453ec2) ||
+		    !lmb_word(LMJ_UI_OUT + slide, 0xf85883a8)) {
+			lmj_live.diag = ENOEXEC;
+		} else {
+			lmj_program(th, LMJ_FB_IN + slide);
+			if (!lmj_live.diag) {
+				lmj_live.stage = LMJ_ARMED;
+			}
+		}
+		lmj_publish();
+		return;
+	}
+	if (lmj_live.tid != thread_tid(th) || lmj_live.pid != proc_selfpid() ||
+	    !lmj_live.stage || lmj_live.stage == LMJ_UI_RETURNED || lmj_live.diag) {
+		return;
+	}
+	if (returning) {
+		if (lmj_live.pending) {
+			lmj_live.pending = 0;
+			lmj_publish();
+		}
+		return;
+	}
+	lmj_live.pending = 1;
+	lmj_live.trap = trap;
+	lmj_live.wait_at = lmj_now();
+	lmj_live.wait_pc = get_saved_state_pc(ss);
+	lmj_live.wait_lr = get_saved_state_lr(ss);
+	memset(lmj_live.wait_frames, 0, sizeof(lmj_live.wait_frames));
+	if (lmb_can_read()) {
+		uint64_t fp = get_saved_state_fp(ss), sp = get_saved_state_sp(ss);
+		for (unsigned i = 0; i < sizeof(lmj_live.wait_frames) / sizeof(lmj_live.wait_frames[0]); ++i) {
+			uint64_t frame[2];
+			if ((fp & 15) || fp < sp || fp - sp > 0x8000 || !lmb_ptr(fp, sizeof(frame)) ||
+			    copyin((user_addr_t)fp, frame, sizeof(frame)) || (frame[1] & 3) ||
+			    !lmb_ptr(frame[1], sizeof(uint32_t))) {
+				break;
+			}
+			lmj_live.wait_frames[i] = frame[1];
+			if (frame[0] <= fp) {
+				break;
+			}
+			fp = frame[0];
+		}
+	}
+	lmj_publish();
+}
+
+static __attribute__((noinline)) bool
+lmj_break(thread_t th, const arm_saved_state_t *ss)
+{
+	const uint64_t pc = get_saved_state_pc(ss);
+	if (lmj_live.tid != thread_tid(th) || !lmb_owned(th, pc)) {
+		return false;
+	}
+	const uint64_t sp = get_saved_state_sp(ss), fp = get_saved_state_fp(ss);
+	const uint64_t lr = get_saved_state_lr(ss), slide = lmj_live.slide;
+	const uint64_t value = const_saved_state64(ss)->x[0];
+	uint64_t next = 0;
+	if (lmj_live.stage == LMJ_ARMED && pc == LMJ_FB_IN + slide && lr == LMJ_FB_OUT + slide) {
+		lmj_live.fb_in = lmj_now();
+		lmj_live.fb_lr = lr;
+		lmj_sp = sp;
+		lmj_fp = fp;
+		lmj_live.stage = LMJ_FB_ENTERED;
+		next = LMJ_FB_OUT + slide;
+	} else if (lmj_live.stage == LMJ_FB_ENTERED && pc == LMJ_FB_OUT + slide && sp == lmj_sp && fp == lmj_fp) {
+		lmj_live.fb_out = lmj_now();
+		lmj_live.object = value != 0;
+		lmj_live.stage = LMJ_FB_RETURNED;
+		next = LMJ_UI_IN + slide;
+	} else if (lmj_live.stage == LMJ_FB_RETURNED && pc == LMJ_UI_IN + slide && lr == LMJ_UI_OUT + slide &&
+	    sp == lmj_sp && fp == lmj_fp) {
+		lmj_live.ui_in = lmj_now();
+		lmj_live.ui_lr = lr;
+		lmj_live.argc = (uint32_t)value;
+		lmj_live.stage = LMJ_UI_ENTERED;
+		next = LMJ_UI_OUT + slide;
+	} else if (lmj_live.stage == LMJ_UI_ENTERED && pc == LMJ_UI_OUT + slide && sp == lmj_sp && fp == lmj_fp) {
+		lmj_live.ui_out = lmj_now();
+		lmj_live.ui_result = (int)value;
+		lmj_live.stage = LMJ_UI_RETURNED;
+	} else {
+		(void)lmb_set(th, 0, 0);
+		lmb_owner = NULL;
+		lmj_live.diag = EINVAL;
+		lmj_live.pending = 0;
+		lmj_publish();
+		return true;
+	}
+	lmj_live.pending = 0;
+	lmj_program(th, next);
+	lmj_publish();
+	return true;
+}
+
+static __attribute__((noinline)) unsigned
+lmj_report(char *out, unsigned cap)
+{
+	if (!__sync_bool_compare_and_swap(&lmb_guard, 0, 1)) {
+		return (unsigned)snprintf(out, cap, "SB handoff/v1 snapshot busy\n");
+	}
+	struct lmj_record row = lmj_snapshot;
+	__sync_lock_release(&lmb_guard);
+	int run_state = -1;
+	if (row.pending) {
+		thread_t th = lmipro_bootstrap_report_thread(row.pid, row.tid);
+		if (th != THREAD_NULL) {
+			thread_basic_info_data_t basic = {};
+			mach_msg_type_number_t n = THREAD_BASIC_INFO_COUNT;
+			if (thread_info_internal(th, THREAD_BASIC_INFO, (thread_info_t)&basic, &n) == KERN_SUCCESS) {
+				run_state = basic.run_state;
+			}
+			thread_deallocate(th);
+		}
+	}
+	const bool stable = row.sequence == __atomic_load_n(&lmj_sequence, __ATOMIC_ACQUIRE);
+	const bool pending = stable && row.pending;
+	return (unsigned)snprintf(out, cap,
+	    "SB handoff/v1 p%d t%llu s%u e%d at%llu cache%llx main%llx stable%u\n"
+	    "FB in%llu out%llu lr%llx obj%u UI in%llu out%llu lr%llx argc%u ret%d\n"
+	    "wait open%u run%d trap%d at%llu pc%llx lr%llx stk%llx/%llx/%llx\n",
+	    row.pid, (unsigned long long)row.tid, row.stage, row.diag, (unsigned long long)row.ready,
+	    row.pid ? (unsigned long long)(LMB_CACHE + row.slide) : 0ULL,
+	    (unsigned long long)row.main, (unsigned)stable,
+	    (unsigned long long)row.fb_in, (unsigned long long)row.fb_out, (unsigned long long)row.fb_lr,
+	    row.object, (unsigned long long)row.ui_in, (unsigned long long)row.ui_out,
+	    (unsigned long long)row.ui_lr, row.argc, row.ui_result,
+	    (unsigned)pending, pending ? run_state : -1, pending ? row.trap : 0,
+	    (unsigned long long)(pending ? row.wait_at : 0), (unsigned long long)(pending ? row.wait_pc : 0),
+	    (unsigned long long)(pending ? row.wait_lr : 0),
+	    (unsigned long long)(pending ? row.wait_frames[0] : 0),
+	    (unsigned long long)(pending ? row.wait_frames[1] : 0),
+	    (unsigned long long)(pending ? row.wait_frames[2] : 0));
+}
+
+/* Recover only the exact already-observed 21H461 wrapper chain at its Mach
+ * trap. The frame of __xpc_interface_routine saves the lookup's x19 (name)
+ * at FP-8 and x23 (output pointer) at FP-40. Breakpoints are installed
+ * only after recovering this exact chain, to observe store and return. */
+static bool
+lmb_inflight(thread_t th, const arm_saved_state_t *ss)
+{
+	static const uint64_t returns[] = {
+		0x1cb7841b0, 0x1cb783fb8, 0x1dd68b7ec, 0x1dd68ac9c,
+		0x1dd669a90, 0x1dd67cb20, 0x1dd67d1f4,
+	};
+	const uint64_t slide = lmb_live.slide;
+	if (get_saved_state_pc(ss) != LMB_MACH2 + slide || !lmb_can_read()) {
+		return false;
+	}
+	uint64_t fp = get_saved_state_fp(ss), sp = get_saved_state_sp(ss);
+	uint64_t frame[2], slots[5], xpc_fp = 0;
+	for (unsigned i = 0; i < sizeof(returns) / sizeof(returns[0]); ++i) {
+		if ((fp & 15) || !lmb_ptr(fp, sizeof(frame)) || fp < sp || fp - sp > 0x8000 ||
+		    copyin((user_addr_t)fp, frame, sizeof(frame)) != 0 || frame[1] != returns[i] + slide ||
+		    frame[0] <= fp) {
+			return false;
+		}
+		if (lmb_live.chain_depth < i + 1) {
+			lmb_live.chain_depth = i + 1;
+		}
+		if (i == 5) {
+			xpc_fp = fp;
+			if (frame[0] - fp != 0x60) {
+				return false;
+			}
+		} else if (i == 6 && frame[0] - fp != 0x30) {
+			return false;
+		}
+		fp = frame[0];
+	}
+	if (!lmb_ptr(fp, sizeof(frame)) || fp - sp > 0x8000 ||
+	    copyin((user_addr_t)fp, frame, sizeof(frame)) != 0 || (frame[1] & 3) ||
+	    !lmb_ptr(frame[1], sizeof(uint32_t)) || !lmb_ptr(xpc_fp - sizeof(slots), sizeof(slots)) ||
+	    !lmb_word(0x1dd6699d0 + slide, 0xa9045ff8) || !lmb_word(0x1dd6699d8 + slide, 0xa9064ff4) ||
+	    copyin((user_addr_t)(xpc_fp - sizeof(slots)), slots, sizeof(slots)) != 0) {
+		return false;
+	}
+	lmb_sp = fp + sizeof(frame);
+	lmb_out = slots[0];
+	lmb_live.caller = frame[1];
+	lmb_live.enter = lmb_live.mach_in = mach_absolute_time();
+	lmb_live.at_seconds = lmipro_ui_stack_seconds();
+	lmb_name(slots[4]);
+	if (!(frame[0] & 15) && frame[0] > fp && frame[0] - fp <= 0x8000 &&
+	    lmb_ptr(frame[0], sizeof(frame)) && copyin((user_addr_t)frame[0], frame, sizeof(frame)) == 0 &&
+	    !(frame[1] & 3) && lmb_ptr(frame[1], sizeof(uint32_t))) {
+		lmb_live.parent = frame[1];
+	}
+	int status = 0;
+	if (!lmipro_bootstrap_debug_allowed() || th->machine.DebugData) {
+		status = EPERM;
+	} else if (arm_debug_info()->num_breakpoint_pairs < 2) {
+		status = ENOTSUP;
+	} else {
+		status = lmb_set(th, LMB_RET + slide, LMB_STORE + slide);
+		lmb_owner = th->machine.DebugData;
+		if (!status && (!lmb_owned(th, LMB_RET + slide) || !lmb_owned(th, LMB_STORE + slide))) {
+			status = EIO;
+		}
+		if (status && lmb_owner != NULL) {
+			(void)lmb_set(th, 0, 0);
+			lmb_owner = NULL;
+		}
+	}
+	lmb_live.diagnostic = status;
+	__atomic_store_n(&lmb_live.phase, status ? LMB_REFUSED : LMB_ENTERED, __ATOMIC_RELEASE);
+	lmb_publish();
+	return true;
+}
+
+static __attribute__((noinline)) void
+lms_observe(thread_t th, const arm_saved_state_t *ss, bool returning)
+{
+	const uint64_t slide = lmb_live.slide, sp = get_saved_state_sp(ss);
+	const uint64_t *regs = const_saved_state64(ss)->x;
+	if (get_saved_state_pc(ss) != LMS_TRAP + slide) {
+		return;
+	}
+	if (returning) {
+		if (lmb_live.ls_stage == 1 && !lmb_live.ls_trap_returned && sp == lms_trap_sp) {
+			lmb_live.ls_trap_returned = 1;
+			lmb_live.ls_trap_result = (int)regs[0];
+			lmb_publish();
+		}
+		return;
+	}
+	if (lmb_live.ls_stage || lmb_live.ls_diag || !lmb_can_read() ||
+	    th->machine.DebugData || !lmipro_bootstrap_debug_allowed() ||
+	    (sp & 15) || !lmb_ptr(sp, 0x560) || get_saved_state_fp(ss) != sp + 0x20 ||
+	    get_saved_state_lr(ss) != UINT64_C(0x1cb784f54) + slide || regs[2] != 0 || regs[3] != 1) {
+		return;
+	}
+	/* Stack from mach_port_mod_refs through the observed LSContext call site. */
+	static const uint16_t offsets[] = {0x20, 0x40, 0x60, 0xd0, 0x360, 0x550};
+	static const uint64_t returns[] = {
+		UINT64_C(0x1dd686494), UINT64_C(0x1dd6736f0), UINT64_C(0x186f61b44), LMS_XPC, LMS_STORE,
+	};
+	for (unsigned i = 0; i < sizeof(returns) / sizeof(returns[0]); ++i) {
+		uint64_t frame[2];
+		if (copyin((user_addr_t)(sp + offsets[i]), frame, sizeof(frame)) ||
+		    frame[0] != sp + offsets[i + 1] || frame[1] != returns[i] + slide) {
+			return;
+		}
+	}
+	if (!lmb_word(LMS_TRAP + slide, 0xd65f03c0) ||
+	    !lmb_word(LMS_XPC + slide, 0xaa0003fb) || !lmb_word(LMS_STORE + slide, 0x340009e0) ||
+	    !lmb_word(LMS_DB + slide, 0xaa0003f8)) {
+		lmb_live.ls_diag = ENOEXEC;
+		lmb_publish();
+		return;
+	}
+	lmb_live.ls_diag = lmb_set(th, LMS_XPC + slide, 0);
+	lmb_owner = th->machine.DebugData;
+	if (!lmb_live.ls_diag && !lmb_owned(th, LMS_XPC + slide)) {
+		lmb_live.ls_diag = EIO;
+	}
+	if (!lmb_live.ls_diag) {
+		lms_trap_sp = sp;
+		lmb_live.ls_stage = 1;
+		lmb_live.ls_at = lmb_live.ls_last = lmipro_ui_stack_seconds();
+	} else if (lmb_owner != NULL) {
+		(void)lmb_set(th, 0, 0);
+		lmb_owner = NULL;
+	}
+	lmb_publish();
+}
+
+static __attribute__((noinline)) bool
+lms_break(thread_t th, const arm_saved_state_t *ss)
+{
+	const uint64_t slide = lmb_live.slide, pc = get_saved_state_pc(ss), sp = get_saved_state_sp(ss);
+	const uint64_t value = const_saved_state64(ss)->x[0];
+	uint64_t next = 0;
+	if (lmb_live.ls_stage == 1 && pc == LMS_XPC + slide && sp == lms_trap_sp + 0xe0) {
+		lmb_live.ls_xpc = value != 0;
+		lmb_live.ls_stage = 2;
+		next = LMS_STORE + slide;
+	} else if (lmb_live.ls_stage == 2 && pc == LMS_STORE + slide && sp == lms_trap_sp + 0x380) {
+		lmb_live.ls_store = (uint32_t)value;
+		lmb_live.ls_stage = 3;
+		if (lmb_live.ls_store) {
+			next = LMS_DB + slide;
+		}
+	} else if (lmb_live.ls_stage == 3 && pc == LMS_DB + slide && sp == lms_trap_sp + 0x380) {
+		lmb_live.ls_db = value != 0;
+		lmb_live.ls_stage = 4;
+	} else {
+		lmb_live.ls_diag = EINVAL;
+	}
+	lmb_live.ls_last = lmipro_ui_stack_seconds();
+	if (next) {
+		lmb_live.ls_diag = lmb_set(th, next, 0);
+		if (!lmb_live.ls_diag && lmb_owned(th, next)) {
+			lmb_publish();
+			return true;
+		}
+		if (!lmb_live.ls_diag) {
+			lmb_live.ls_diag = EIO;
+		}
+	}
+	(void)lmb_set(th, 0, 0);
+	lmb_owner = NULL;
+	lmb_publish();
+	return true;
+}
+
+static __attribute__((noinline)) void
+lmipro_bootstrap_svc(thread_t th, arm_saved_state_t *ss, int trap, bool returning)
+{
+	if (lmj_enabled()) {
+		lmj_svc(th, ss, trap, returning);
+		return;
+	}
+	const unsigned config = lmb_setting();
+	if (config <= 1 || !(thread_get_tag(th) & THREAD_TAG_MAINTHREAD)) {
+		return;
+	}
+	unsigned phase = __atomic_load_n(&lmb_live.phase, __ATOMIC_ACQUIRE);
+	if (phase == LMB_RETURNED && trap == -19 && lmb_live.tid == thread_tid(th) &&
+	    lmb_live.ui_step == 3 && lmb_live.shell_init_lr && lmb_live.shell_object) {
+		lms_observe(th, ss, returning);
+		return;
+	}
+	if (phase == LMB_RETURNED && lmb_live.disp == LMD_ENTERED && trap == -47 &&
+	    lmb_live.tid == thread_tid(th) && get_saved_state_pc(ss) == LMB_MACH2 + lmb_live.slide) {
+		const uint64_t *x = const_saved_state64(ss)->x;
+		if (!returning && (x[1] & 3) == 3 && (uint32_t)x[3] == lmb_live.port &&
+		    x[4] >> 32 == LMD_ID) {
+			lmd_trap_sp = get_saved_state_sp(ss);
+			lmb_live.disp_mach_in = mach_absolute_time();
+			lmb_live.disp_mach_out = 0;
+		} else if (returning && lmb_live.disp_mach_in && !lmb_live.disp_mach_out &&
+		    lmd_trap_sp == get_saved_state_sp(ss)) {
+			lmb_live.disp_mach_out = mach_absolute_time();
+			lmb_live.disp_trap_status = (int)x[0];
+		} else {
+			return;
+		}
+		lmb_publish();
+		return;
+	}
+	if (phase == LMB_ENTERED) {
+		if (trap == -47 && lmb_live.tid == thread_tid(th) &&
+		    get_saved_state_pc(ss) == LMB_MACH2 + lmb_live.slide) {
+			if (!returning) {
+				lmb_live.mach_in = mach_absolute_time();
+				lmb_live.mach_out = 0;
+			} else if (lmb_live.mach_in && !lmb_live.mach_out) {
+				lmb_live.mach_out = mach_absolute_time();
+				lmb_live.mach_status = (int)const_saved_state64(ss)->x[0];
+			}
+			lmb_publish();
+		}
+		return;
+	}
+	if (phase == LMB_SCANNING && !returning && trap == -47 && lmb_live.tid == thread_tid(th) &&
+	    get_saved_state_pc(ss) == LMB_MACH2 + lmb_live.slide && lmb_can_read() &&
+	    lmb_live.chain_checked < 4096) {
+		++lmb_live.chain_checked;
+		if (!lmb_inflight(th, ss)) {
+			lmb_publish();
+		}
+		return;
+	}
+	if (returning || trap != -47 || phase != LMB_IDLE || !lmb_can_read() ||
+	    lmipro_ui_stack_seconds() < config - 2) {
+		return;
+	}
+	char name[17] = {};
+	proc_selfname(name, sizeof(name));
+	if (strcmp(name, "SpringBoard")) {
+		return;
+	}
+	task_t task = current_task();
+	uint32_t slide = task->task_shared_region_slide;
+	if (slide == UINT32_MAX || get_saved_state_pc(ss) != LMB_MACH2 + slide) {
+		return; /* dyld has not published the cache yet */
+	}
+	unsigned idle = LMB_IDLE;
+	if (!__atomic_compare_exchange_n(&lmb_live.phase, &idle, LMB_QUALIFYING, false,
+	    __ATOMIC_ACQ_REL, __ATOMIC_RELAXED)) {
+		return;
+	}
+	lmb_live.pid = proc_selfpid();
+	lmb_live.tid = thread_tid(th);
+	lmb_live.slide = slide;
+	lmb_live.main_base = task->mach_header_vm_address;
+	lmb_live.ready_seconds = lmipro_ui_stack_seconds();
+	int status = 0;
+	if (memcmp(task->task_shared_region_uuid, lmb_uuid, sizeof(lmb_uuid)) ||
+	    (slide & 0xfff) || !lmb_word(LMB_ENTRY + slide, 0xd100c3ff) ||
+	    !lmb_word(LMB_STORE + slide, 0xb90002f9) || !lmb_word(LMB_RET + slide, 0xd65f03c0)) {
+		status = ENOEXEC;
+	}
+	lmb_live.diagnostic = status;
+	__atomic_store_n(&lmb_live.phase, status ? LMB_REFUSED : LMB_SCANNING, __ATOMIC_RELEASE);
+	if (!status) {
+		++lmb_live.chain_checked;
+		if (lmb_inflight(th, ss)) {
+			return;
+		}
+	}
+	lmb_publish();
+}
+
+/* Arm only a verified caller reached across GetMainScreenInfo and BKS Start.
+ * Pair every checkpoint with the stack pointer of that activation. */
+static bool
+lmu_arm(thread_t th, const arm_saved_state_t *ss)
+{
+	const uint64_t slide = lmb_live.slide, sp = lmd_sp;
+	if (lmb_live.disp_upper != UINT64_C(0x18f65c884) + slide ||
+	    !lmb_ptr(sp, 0xf0) || get_saved_state_fp(ss) != sp + 0x50) {
+		lmb_live.ui_diag = EINVAL;
+		return false;
+	}
+	uint64_t frame[2] = {};
+	if (copyin((user_addr_t)(sp + 0x50), frame, sizeof(frame)) || frame[0] != sp + 0xe0 ||
+	    frame[1] != lmb_live.disp_upper || copyin((user_addr_t)frame[0], frame, sizeof(frame))) {
+		lmb_live.ui_diag = EFAULT;
+		return false;
+	}
+	lmb_live.ui_caller = frame[1];
+	const bool shell = frame[1] == lmu_shell_sites[0].pc + slide;
+	if (!shell && frame[1] != lmu_sites[0].pc + slide) {
+		lmb_live.ui_diag = ENOEXEC;
+		return false;
+	}
+	const struct lmu_site *sites = shell ? lmu_shell_sites : lmu_sites;
+	const unsigned count = shell ? LMU_SHELL_ACTIVATION_COUNT : LMU_COUNT;
+	for (unsigned i = 0; i < count; ++i) {
+		if (!lmb_word(sites[i].pc + slide, sites[i].op)) {
+			lmb_live.ui_diag = ENOEXEC;
+			return false;
+		}
+	}
+	if (shell) {
+		if (!lmb_word(UINT64_C(0x18f6929f0) + slide, 0x910543fd) ||
+		    !lmb_word(UINT64_C(0x18f692bb4) + slide, 0x97ff2720) ||
+		    !lmb_word(UINT64_C(0x18f692c90) + slide, 0x910583ff)) {
+			lmb_live.ui_diag = ENOEXEC;
+			return false;
+		}
+		if (frame[0] != sp + 0x240 || !lmb_ptr(frame[0], sizeof(frame)) ||
+		    copyin((user_addr_t)frame[0], frame, sizeof(frame)) || (frame[1] & 3) ||
+		    !lmb_ptr(frame[1], sizeof(uint32_t))) {
+			lmb_live.ui_diag = EFAULT;
+			return false;
+		}
+		lmb_live.shell_parent = frame[1];
+		/* The known initializer saves FP/LR 0x60 above the shell's return SP. */
+		if (lmb_live.shell_parent == UINT64_C(0x18f691ef4) + slide &&
+		    frame[0] == sp + 0x2b0 && lmb_ptr(frame[0], sizeof(frame)) &&
+		    !copyin((user_addr_t)frame[0], frame, sizeof(frame)) && !(frame[1] & 3) &&
+		    lmb_ptr(frame[1], sizeof(uint32_t)) &&
+		    lmb_word(UINT64_C(0x18f691dec) + slide, 0x910183fd) &&
+		    lmb_word(UINT64_C(0x18f691ef0) + slide, 0x94011c64) &&
+		    lmb_word(UINT64_C(0x18f691f24) + slide, 0x9101c3ff) &&
+		    lmb_word(lmu_shell_sites[2].pc + slide, lmu_shell_sites[2].op)) {
+			lmb_live.shell_init_lr = frame[1];
+		}
+	}
+	lmu_sp = sp + 0xf0;
+	lmb_live.ui_diag = lmb_set(th, sites[0].pc + slide, 0);
+	if (!lmb_live.ui_diag && !lmb_owned(th, sites[0].pc + slide)) {
+		lmb_live.ui_diag = EIO;
+	}
+	lmb_live.ui_armed = lmb_live.ui_diag == 0;
+	return lmb_live.ui_armed;
+}
+
+static bool
+lmu_break(thread_t th, const arm_saved_state_t *ss)
+{
+	const unsigned i = lmb_live.ui_step;
+	const uint64_t slide = lmb_live.slide;
+	const bool shell = lmb_live.shell_parent != 0;
+	const struct lmu_site *sites = shell ? lmu_shell_sites : lmu_sites;
+	const unsigned count = shell ?
+	    (lmb_live.shell_init_lr ? LMU_SHELL_COUNT : LMU_SHELL_ACTIVATION_COUNT) : LMU_COUNT;
+	uint64_t expected_sp = lmu_sp;
+	uint64_t expected_lr = 0;
+	if (shell && i == 1) {
+		expected_sp += 0x160;
+		expected_lr = lmb_live.shell_parent;
+	} else if (shell && i == 2) {
+		expected_sp += 0x160 + 0x70;
+		expected_lr = lmb_live.shell_init_lr;
+	}
+	if (i < count && get_saved_state_pc(ss) == sites[i].pc + slide &&
+	    get_saved_state_sp(ss) == expected_sp &&
+	    (!expected_lr || get_saved_state_lr(ss) == expected_lr)) {
+		if (i == 0) {
+			lmb_live.ui_start_result = (uint32_t)const_saved_state64(ss)->x[0];
+		} else if (shell && i == 2) {
+			lmb_live.shell_object = const_saved_state64(ss)->x[0] != 0;
+		}
+		lmb_live.ui_step = i + 1;
+		lmb_live.ui_at = lmipro_ui_stack_seconds();
+		if (i + 1 < count && (shell || i || lmb_live.ui_start_result == 1)) {
+			lmb_live.ui_diag = lmb_set(th, sites[i + 1].pc + slide, 0);
+			if (!lmb_live.ui_diag && lmb_owned(th, sites[i + 1].pc + slide)) {
+				lmb_publish();
+				return true;
+			}
+			if (!lmb_live.ui_diag) {
+				lmb_live.ui_diag = EIO;
+			}
+		}
+	} else {
+		lmb_live.ui_diag = EINVAL;
+	}
+	(void)lmb_set(th, 0, 0);
+	lmb_owner = NULL;
+	lmb_publish();
+	return true;
+}
+
+/* Follow only the screen-info call immediately after the proven lookup.
+ * At the MIG return, the caller's six real output slots are still live. */
+static bool
+lmd_break(thread_t th, const arm_saved_state_t *ss)
+{
+	const uint64_t slide = lmb_live.slide, pc = get_saved_state_pc(ss);
+	const uint64_t lr = get_saved_state_lr(ss), sp = get_saved_state_sp(ss);
+	const uint64_t *x = const_saved_state64(ss)->x;
+	if (lmb_live.disp == LMD_ARMED && pc == LMD_ENTRY + slide && lr == LMD_LR + slide &&
+	    lmb_can_read() && !(sp & 15) && lmb_ptr(sp, 0x60) && (uint32_t)x[0] == lmb_live.port &&
+	    x[1] == sp + 0x1c && x[2] == sp + 0x18 && x[3] == sp + 0x14 &&
+	    x[4] == sp + 0x10 && x[5] == sp + 0xf && x[6] == sp + 0xe) {
+		uint64_t upper = 0;
+		if (get_saved_state_fp(ss) == sp + 0x50 &&
+		    copyin((user_addr_t)(sp + 0x58), &upper, sizeof(upper)) == 0 &&
+		    !(upper & 3) && lmb_ptr(upper, sizeof(uint32_t))) {
+			lmb_live.disp_upper = upper;
+		}
+		lmd_sp = sp;
+		lmb_live.disp_at = lmipro_ui_stack_seconds();
+		lmb_live.disp_diag = lmb_set(th, LMD_MACH + slide, LMD_RET + slide);
+		if (!lmb_live.disp_diag) {
+			lmb_live.disp = LMD_ENTERED;
+			lmb_publish();
+			return true;
+		}
+	} else if (lmb_live.disp == LMD_ENTERED && pc == LMD_MACH + slide &&
+	    lmd_sp >= 0xa0 && sp == lmd_sp - 0xa0) {
+		lmb_live.disp_transport = (int)x[0];
+		lmb_live.disp_mach_ret = 1;
+		lmb_live.disp_diag = lmb_set(th, LMD_RET + slide, 0);
+		if (!lmb_live.disp_diag) {
+			lmb_publish();
+			return true;
+		}
+	} else if (lmb_live.disp == LMD_ENTERED && pc == LMD_RET + slide &&
+	    lr == LMD_LR + slide && sp == lmd_sp && lmb_can_read()) {
+		lmb_live.disp_result = (int)x[0];
+		if (!lmb_live.disp_result) {
+			uint8_t buf[18] = {};
+			if (copyin((user_addr_t)(sp + 0xe), buf, sizeof(buf)) == 0) {
+				for (unsigned i = 0; i < 4; ++i) {
+					memcpy(&lmb_live.disp_words[i], buf + 14 - 4 * i, sizeof(uint32_t));
+				}
+				lmb_live.disp_flags[0] = buf[1];
+				lmb_live.disp_flags[1] = buf[0];
+				lmb_live.disp_output = 1;
+			}
+		}
+		lmb_live.disp = LMD_RETURNED;
+		if (!lmb_live.disp_output || !lmu_arm(th, ss)) {
+			lmb_live.disp_diag = lmb_set(th, 0, 0);
+			lmb_owner = NULL;
+		}
+		lmb_publish();
+		return true;
+	}
+	(void)lmb_set(th, 0, 0);
+	lmb_owner = NULL;
+	lmb_live.disp = LMD_INVALID;
+	lmb_publish();
+	return true;
+}
+
+static __attribute__((noinline)) bool
+lmipro_bootstrap_break(thread_t th, const arm_saved_state_t *ss)
+{
+	if (lmj_enabled()) {
+		return lmj_break(th, ss);
+	}
+	const uint64_t pc = get_saved_state_pc(ss);
+	unsigned phase = __atomic_load_n(&lmb_live.phase, __ATOMIC_ACQUIRE);
+	if (lmb_live.tid != thread_tid(th) || !lmb_owned(th, pc)) {
+		return false;
+	}
+	if (phase == LMB_RETURNED && lmb_live.disp == LMD_RETURNED && lmb_live.ui_armed) {
+		if (lmb_live.ls_stage) {
+			return lms_break(th, ss);
+		}
+		return lmu_break(th, ss);
+	}
+	if (phase == LMB_RETURNED && (lmb_live.disp == LMD_ARMED || lmb_live.disp == LMD_ENTERED)) {
+		return lmd_break(th, ss);
+	}
+	if (phase != LMB_ENTERED) {
+		return false;
+	}
+	const uint64_t slide = lmb_live.slide;
+	const uint64_t caller = get_saved_state_lr(ss);
+	const uint64_t sp = get_saved_state_sp(ss);
+	const uint64_t *regs = const_saved_state64(ss)->x;
+	if (pc == LMB_STORE + slide && lmb_can_read() &&
+	    lmb_sp >= 0x90 && sp == lmb_sp - 0x90 && regs[23] == lmb_out) {
+		/* The next instruction is the original _bootstrap_look_up3 store.
+		 * Disable this breakpoint before letting that instruction run. */
+		lmb_live.stored = 1;
+		lmb_expected = (mach_port_name_t)regs[25];
+		lmb_live.diagnostic = lmb_set(th, LMB_RET + slide, 0);
+		if (!lmb_live.diagnostic) {
+			lmb_publish();
+			return true;
+		}
+	} else if (phase == LMB_ENTERED && pc == LMB_RET + slide && lmb_sp == sp &&
+	    caller == lmb_live.caller && lmb_can_read()) {
+		lmb_live.end = mach_absolute_time();
+		lmb_live.result = (kern_return_t)regs[0];
+		if (lmb_live.result == KERN_SUCCESS && lmb_live.stored) {
+			mach_port_name_t port = MACH_PORT_NULL;
+			mach_port_type_t type = 0;
+			lmb_live.port_check = 1; /* store seen, no validated right yet */
+			if (!(lmb_out & 3) && lmb_ptr(lmb_out, sizeof(port)) &&
+			    copyin((user_addr_t)lmb_out, &port, sizeof(port)) == 0 && port == lmb_expected &&
+			    MACH_PORT_VALID(port) &&
+			    mach_port_type(current_task()->itk_space, port, &type) == KERN_SUCCESS &&
+			    (type & MACH_PORT_TYPE_SEND)) {
+				lmb_live.port_check = 2;
+				lmb_live.port = port;
+			}
+		}
+		if (lmb_live.port_check == 2 && lmb_live.caller == 0x18f65d674 + slide &&
+		    lmb_live.parent == 0x18f65cb7c + slide &&
+		    !strcmp(lmb_live.name, "com.apple.backboard.display.services")) {
+			if (lmb_word(LMD_ENTRY + slide, 0xd10283ff) && lmb_word(LMD_MACH + slide, 0xaa0003f3) &&
+			    lmb_word(LMD_RET + slide, 0xd65f03c0)) {
+				lmb_live.disp_diag = lmb_set(th, LMD_ENTRY + slide, 0);
+				if (!lmb_live.disp_diag && lmb_owned(th, LMD_ENTRY + slide)) {
+					lmb_live.disp = LMD_ARMED;
+				}
+			} else {
+				lmb_live.disp_diag = ENOEXEC;
+			}
+			if (lmb_live.disp != LMD_ARMED) {
+				lmb_live.disp = LMD_INVALID;
+			}
+		}
+		if (lmb_live.disp != LMD_ARMED) {
+			lmb_live.diagnostic = lmb_set(th, 0, 0);
+			lmb_owner = NULL;
+		}
+		__atomic_store_n(&lmb_live.phase, LMB_RETURNED, __ATOMIC_RELEASE);
+		lmb_publish();
+		return true;
+	}
+	/* Do not repeatedly trap on our instruction if an ABI/call-pair check
+	 * fails. Let the original instruction execute, and mark the sample invalid. */
+	(void)lmb_set(th, 0, 0);
+	lmb_owner = NULL;
+	__atomic_store_n(&lmb_live.phase, LMB_MISMATCH, __ATOMIC_RELEASE);
+	lmb_publish();
+	return true;
+}
+
+unsigned lmipro_bootstrap_report(char *, unsigned);
+__attribute__((noinline)) unsigned
+lmipro_bootstrap_report(char *out, unsigned cap)
+{
+	if (!out || !cap) {
+		return 0;
+	}
+	out[0] = 0;
+	if (lmj_enabled()) {
+		return lmj_report(out, cap);
+	}
+	const unsigned config = lmb_setting();
+	if (config <= 1) {
+		return 0;
+	}
+	if (!__sync_bool_compare_and_swap(&lmb_guard, 0, 1)) {
+		return (unsigned)snprintf(out, cap, "SB lookup/v3 snapshot busy\n");
+	}
+	struct lmb_record row = lmb_snapshot;
+	__sync_lock_release(&lmb_guard);
+	int run_state = -1;
+	if (row.phase == LMB_ENTERED || row.disp == LMD_ENTERED) {
+		thread_t th = lmipro_bootstrap_report_thread(row.pid, row.tid);
+		if (th != THREAD_NULL) {
+			thread_basic_info_data_t basic = {};
+			mach_msg_type_number_t n = THREAD_BASIC_INFO_COUNT;
+			if (thread_info_internal(th, THREAD_BASIC_INFO, (thread_info_t)&basic, &n) == KERN_SUCCESS) {
+				run_state = basic.run_state;
+			}
+			thread_deallocate(th);
+		}
+	}
+	/* If the wrapper returned during the task/thread lookup, prefer its
+	 * paired return over combining a stale open row with a new run state. */
+	if ((row.phase == LMB_ENTERED || row.disp == LMD_ENTERED) &&
+	    __sync_bool_compare_and_swap(&lmb_guard, 0, 1)) {
+		if (lmb_snapshot.phase != row.phase || lmb_snapshot.mach_in != row.mach_in ||
+		    lmb_snapshot.mach_out != row.mach_out || lmb_snapshot.disp != row.disp ||
+		    lmb_snapshot.disp_mach_in != row.disp_mach_in || lmb_snapshot.disp_mach_out != row.disp_mach_out) {
+			row = lmb_snapshot;
+			run_state = -1;
+		}
+		__sync_lock_release(&lmb_guard);
+	}
+	if (row.disp != LMD_OFF) {
+		uint64_t age = 0;
+		if (row.disp_mach_in) {
+			absolutetime_to_nanoseconds((row.disp_mach_out ? row.disp_mach_out : mach_absolute_time()) -
+			    row.disp_mach_in, &age);
+		}
+		return (unsigned)snprintf(out, cap,
+		    "BKS screen/v1 p%d t%llu bootRet%d port%x state%u diag%u\n"
+		    "id6001011 at%llu trap%u/%u/%x ageMs%llu run%d msg%u/%x ret%u/%d\n"
+		    "out%u %x/%x/%x/%x flags%x/%x upper%llx cache%llx main%llx\n"
+		    "%s arm%u step%u diag%u bks%u at%llu caller%llx parent%llx\n"
+		    "BKS init object%u next%llx\n"
+		    "LS store/v1 s%u e%d trap%u/%d xpc%u store%u db%u at%llu/%llu\n",
+		    row.pid, (unsigned long long)row.tid, row.result, row.port, row.disp, row.disp_diag,
+		    (unsigned long long)row.disp_at, (unsigned)(row.disp_mach_in != 0),
+		    (unsigned)(row.disp_mach_out != 0), (unsigned)row.disp_trap_status,
+		    (unsigned long long)(age / UINT64_C(1000000)), run_state, row.disp_mach_ret,
+		    (unsigned)row.disp_transport, (unsigned)(row.disp == LMD_RETURNED), row.disp_result,
+		    row.disp_output, row.disp_words[0], row.disp_words[1], row.disp_words[2], row.disp_words[3],
+		    (unsigned)row.disp_flags[0], (unsigned)row.disp_flags[1], (unsigned long long)row.disp_upper,
+		    (unsigned long long)(LMB_CACHE + row.slide), (unsigned long long)row.main_base,
+		    row.shell_parent ? "BKS shell/v1" : "UIKit init/v1", row.ui_armed, row.ui_step, row.ui_diag,
+		    row.ui_start_result, (unsigned long long)row.ui_at, (unsigned long long)row.ui_caller,
+		    (unsigned long long)row.shell_parent, row.shell_object,
+		    (unsigned long long)row.shell_init_lr, row.ls_stage, row.ls_diag,
+		    row.ls_trap_returned, row.ls_trap_result, row.ls_xpc, row.ls_store, row.ls_db,
+		    (unsigned long long)row.ls_at, (unsigned long long)row.ls_last);
+	}
+	uint64_t ms = 0, mms = 0;
+	if (row.enter) {
+		absolutetime_to_nanoseconds((row.end ? row.end : mach_absolute_time()) - row.enter, &ms);
+	}
+	if (row.mach_in) {
+		absolutetime_to_nanoseconds((row.mach_out ? row.mach_out : mach_absolute_time()) - row.mach_in, &mms);
+	}
+	return (unsigned)snprintf(out, cap,
+	    "SB lookup/v3 from%u phase%u diag%d p%d t%llu lost%u\n"
+	    "name=%s err%u ret%u/%d store%u port%u/%x\n"
+	    "lr=%llx parent=%llx main=%llx cache=%llx xpc=%llx\n"
+	    "at=%llu ticks=%llx ageMs=%llu run=%d mach=%u/%u/%x ageMs=%llu\n"
+	    "ready=%llu checks=%u depth=%u\n",
+	    config - 2, row.phase, row.diagnostic, row.pid, (unsigned long long)row.tid,
+	    __atomic_load_n(&lmb_lost, __ATOMIC_RELAXED), row.name[0] ? row.name : "?", row.name_error,
+	    (unsigned)(row.phase == LMB_RETURNED), row.result, row.stored, row.port_check, row.port,
+	    (unsigned long long)row.caller, (unsigned long long)row.parent, (unsigned long long)row.main_base,
+	    row.phase ? (unsigned long long)(LMB_CACHE + row.slide) : 0ULL,
+	    row.phase ? (unsigned long long)(LMB_XPC + row.slide) : 0ULL,
+	    (unsigned long long)row.at_seconds, (unsigned long long)row.enter, (unsigned long long)(ms / UINT64_C(1000000)), run_state,
+	    (unsigned)(row.mach_in != 0), (unsigned)(row.mach_out != 0), (unsigned)row.mach_status, (unsigned long long)(mms / UINT64_C(1000000)),
+	    (unsigned long long)row.ready_seconds, row.chain_checked, row.chain_depth);
+}
