+bool
+lmipro_bootstrap_debug_allowed(void)
+{
+	proc_t p = current_proc();
+	if (!p) {
+		return false;
+	}
+	proc_lock(p);
+	bool allowed = !(p->p_lflag & (P_LNOATTACH | P_LTRACED));
+	proc_unlock(p);
+	return allowed;
+}
+
+thread_t
+lmipro_bootstrap_report_thread(int pid, uint64_t tid)
+{
+	proc_t p = proc_find(pid);
+	if (!p) {
+		return THREAD_NULL;
+	}
+	task_t task = proc_task(p);
+	thread_t th = task ? task_findtid(task, tid) : THREAD_NULL;
+	proc_rele(p);
+	return th;
+}
