--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -8083,6 +8083,124 @@
 }
 #endif
 
+/* Board scratch Data: exact seed, typed RAM provider, no disk writes. */
+#if defined(XNU_OWNER_CACHE_MOUNT) && XNU_OWNER_CACHE_MOUNT
+#define LMIPRO_DATA_UUID "32EC6E37-C75B-4305-AA27-C2FEA4E67F30"
+static const uint8_t lmipro_data_expected_sha256[32] = { 0x8e,0x9f,0xf9,0x8f,0x62,0xa4,0xdf,0xc5,0xf8,0xe8,0x2e,0xf3,0x0f,0x43,0x5c,0xfe,0x03,0x5a,0xb9,0x83,0x0f,0xac,0x59,0x21,0x0f,0x8f,0x6a,0x67,0xa5,0xef,0x09,0x7c };
+extern int native_ram_block_volume_seed(const char *, dev_t *, char *, size_t, uint64_t *, uint64_t *, uint8_t *);
+volatile int lmipro_data_status = -1;
+volatile int lmipro_data_stage = -2;
+volatile int lmipro_data_readonly = -1;
+volatile dev_t lmipro_data_device = NODEV;
+uint64_t lmipro_data_seed_base, lmipro_data_seed_size;
+uint8_t lmipro_data_seed_sha256[32];
+char lmipro_data_device_path[64];
+
+static int
+lmipro_data_prepare(proc_t p, user_addr_t scratch)
+{
+	uint64_t base = 0, size = 0;
+	dev_t device = NODEV;
+	int error = EINVAL;
+	vnode_t data_root = NULLVP;
+	char device_path[64] = {0};
+	/* The typed provider supplies logical seed identity for both dense and
+	 * sparse media. A sparse disk has no contiguous logical-byte address. */
+	if (!native_ram_block_volume_seed(LMIPRO_DATA_UUID, &device, device_path,
+	    sizeof(device_path), &base, &size, lmipro_data_seed_sha256)) { error = ENOENT; goto done; }
+	/* The typed provider's disk may be far larger than 2 GiB (a persistent Data disk keeps only its seed's nonzero pages). */
+	if (size != UINT64_C(33554432) || memcmp(lmipro_data_seed_sha256,
+            lmipro_data_expected_sha256, 32)) goto done;
+	lmipro_data_seed_base = base;
+	lmipro_data_seed_size = size;
+	lmipro_data_stage = 1;
+	strlcpy(lmipro_data_device_path, device_path, sizeof(lmipro_data_device_path));
+	uint8_t payload[0x150] = {0};
+	user64_addr_t spec = scratch + 0x160;
+	uint16_t mode = 1;
+	uint32_t anonymous_owner = 99;
+	memcpy(payload, &spec, sizeof(spec));
+	memcpy(payload + 16, &mode, sizeof(mode));
+	memcpy(payload + 0x144, &anonymous_owner, sizeof(anonymous_owner));
+	memcpy(payload + 0x148, &anonymous_owner, sizeof(anonymous_owner));
+	struct mount_args request = {.type = scratch + 0x100, .path = scratch + 0x120,
+	    .flags = 0, .data = scratch + 0x200};
+	int32_t result = 0;
+	if ((error = copyout("apfs", request.type, 5)) ||
+	    (error = copyout("/private/var", request.path, 13)) ||
+	    (error = copyout(device_path, spec, strlen(device_path) + 1)) ||
+	    (error = copyout(payload, request.data, sizeof(payload)))) goto done;
+	lmipro_data_stage = 2;
+	error = mount(p, &request, &result);
+	if (error) goto done;
+	lmipro_data_stage = 3;
+	error = vnode_lookup("/private/var", 0, &data_root, vfs_context_current());
+	if (error) goto done;
+	mount_t data_mount = vnode_mount(data_root);
+	vnode_t device_node = vfs_devvp(data_mount);
+	dev_t actual = device_node ? vnode_specrdev(device_node) : NODEV;
+	if (device_node) vnode_put(device_node);
+	lmipro_data_device = actual;
+	lmipro_data_readonly = (vfs_flags(data_mount) & MNT_RDONLY) != 0;
+	if (actual != device || (vfs_flags(data_mount) & MNT_RDONLY) ||
+	    strcmp(vfs_statfs(data_mount)->f_fstypename, "apfs")) error = EINVAL;
+	if (!error) {
+		lmipro_data_stage = 4;
+		/* Disable the two wallpaper extensions by their launchd labels: each
+		 * faults on a userspace pointer every boot and stops the compositor before
+		 * its first swap. launchd's disabled list is a small XML plist. */
+		static const char lite_policy[] =
+		    "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+		    "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" "
+		    "\"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
+		    "<plist version=\"1.0\"><dict>\n"
+		    "<key>com.apple.NanoUniverse.AegirProxyApp.AegirPoster</key><true/>\n"
+		    "<key>com.apple.WatchFacesWallpaperSupport.KaleidoscopePoster</key><true/>\n"
+		    "</dict></plist>\n";
+		const char *policy_dir = "/private/var/db/com.apple.xpc.launchd";
+		const char *policy_path = "/private/var/db/com.apple.xpc.launchd/disabled.plist";
+		int32_t policy_result = 0;
+		int policy_fd = -1;
+		int policy_error = 0;
+		struct mkdir_args policy_mkdir = { .path = scratch, .mode = 0755 };
+		if ((policy_error = copyout(policy_dir, scratch, strlen(policy_dir) + 1))) goto policy_done;
+		policy_error = mkdir(p, &policy_mkdir, &policy_result);
+		if (policy_error && policy_error != EEXIST) goto policy_done;
+		policy_error = 0;
+		if ((policy_error = copyout(policy_path, scratch, strlen(policy_path) + 1))) goto policy_done;
+		struct open_args policy_open = { .path = scratch,
+		    .flags = O_WRONLY | O_CREAT | O_TRUNC | O_NOFOLLOW, .mode = 0644 };
+		if ((policy_error = open(p, &policy_open, &policy_result))) goto policy_done;
+		policy_fd = policy_result;
+		for (size_t sent = 0, total = strlen(lite_policy); sent < total; ) {
+			size_t piece = total - sent < 0x1f0 ? total - sent : 0x1f0;
+			if ((policy_error = copyout(lite_policy + sent, scratch + 0x200, piece))) goto policy_done;
+			struct write_args policy_write = { .fd = policy_fd, .cbuf = scratch + 0x200, .nbyte = piece };
+			user_ssize_t policy_written = 0;
+			if ((policy_error = write(p, &policy_write, &policy_written))) goto policy_done;
+			if (policy_written != (user_ssize_t)piece) { policy_error = EIO; goto policy_done; }
+			sent += piece;
+		}
+		struct fchown_args policy_owner = { .fd = policy_fd, .uid = 0, .gid = 0 };
+		if ((policy_error = fchown(p, &policy_owner, &policy_result))) goto policy_done;
+		struct fchmod_args policy_mode = { .fd = policy_fd, .mode = 0644 };
+		if ((policy_error = fchmod(p, &policy_mode, &policy_result))) goto policy_done;
+		struct fsync_args policy_sync = { .fd = policy_fd };
+		policy_error = fsync(p, &policy_sync);
+policy_done:
+		if (policy_fd >= 0) {
+			struct close_args policy_close = { .fd = policy_fd };
+			close(p, &policy_close, &policy_result);
+		}
+		if (policy_error) lmipro_data_status = policy_error;
+	}
+done:
+	if (data_root) vnode_put(data_root);
+	lmipro_data_status = error;
+	return error;
+}
+#endif
+
 static int
 load_init_program_at_path(proc_t p, user_addr_t scratch_addr, const char* path, user_addr_t envp)
 {
@@ -8222,11 +8340,18 @@
 	user_addr_t init_envp = USER_ADDR_NULL;
 #if defined(XNU_OWNER_CACHE_MOUNT) && XNU_OWNER_CACHE_MOUNT
 	boot_progress_stage("SystemOS mount enter");
+	lmipro_data_stage = 10; /* SystemOS preparation entered */
 	int cache_error = native_owner_cache_prepare(p, (user_addr_t)scratch_addr, &init_envp);
 	boot_progress_stage("SystemOS mount returned");
 	if (cache_error) panic("offline owner SystemOS mount failed: %d", cache_error);
+	lmipro_data_stage = 11; /* SystemOS returned; publishing identity */
 	extern int lmipro_publish_boot_identity(void);
 	if (!lmipro_publish_boot_identity()) panic("LMIPRO boot identity publication failed");
+	lmipro_data_stage = 0; /* RAM provider lookup entered */
+	int lmipro_data_error = lmipro_data_prepare(p, (user_addr_t)scratch_addr);
+	if (lmipro_data_error) panic("LMIPRO Data mount failed: error=%d stage=%d readonly=%d",
+	    lmipro_data_error, lmipro_data_stage, lmipro_data_readonly);
+	boot_progress_stage("LMIPRO writable RAM Data mounted");
 #endif
 #if defined(XNU_OWNER_DATA_MOUNT) && XNU_OWNER_DATA_MOUNT
 	boot_progress_stage("Data mount enter");
