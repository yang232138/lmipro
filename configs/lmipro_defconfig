# lmipro_defconfig: board-level kernel configuration.
#
# The arch, SoC and OS fragments listed in board.toml [kernel] config_fragments
# are applied first; every CONFIG_XNU_<NAME> here becomes XNU_<NAME> and overrides
# them. Only what differs from the shared layers belongs in this file.
#
# The shared layers already set the generic path this port starts from:
#   CONFIG_XNU_ARM_DT_PLATFORM, CONFIG_XNU_ARMCPU, CONFIG_XNU_NATIVE_ARCH_TIMER,
#   CONFIG_XNU_NATIVE_PAN, CONFIG_XNU_SOURCE_CORECRYPTO14, CONFIG_XNU_SOURCE_PTHREAD,
#   CONFIG_XNU_BUILD_ARCHIVES and CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked".
#
# No board driver is settled yet. Each entry below turns on only when its component
# is selected in board.toml and its hardware input exists (see porting.toml).
# CONFIG_XNU_NATIVE_UFS is not set
# CONFIG_XNU_NATIVE_ADRENO is not set

# Use the upstream validated device-tree panic region on this SM8250 board.
# BCM2837's fixed 0x3c0fc000 panic buffer is not a board input for lmipro.
CONFIG_XNU_DT_PANIC_REGION=y


# Opt-in ABI-gated original PMGR integration; runtime mode defaults off.
CONFIG_XNU_SHENG_PMGR=y

# Canonical RAM-only block transport; no UFS driver or persistent store.
CONFIG_XNU_NATIVE_RAM_BLOCK=y

# Official crypto instrument only; owner root trust remains disabled.
CONFIG_XNU_VERIFIED_ROOT_PROBE=y

# Signed readonly RAM-root binding audit; acceptance remains OFF.
# CONFIG_XNU_SOURCE_MOCKFS is not set
CONFIG_XNU_OWNER_ROOT_AUDIT=y
# CONFIG_XNU_OWNER_ROOT_TRUST is not set
