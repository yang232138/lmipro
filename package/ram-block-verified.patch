+// Resolve the ACTUAL mounted BSD device to exactly one IOMedia, then require
+// its signed volume UUID and this real transport in its provider ancestry.
+extern "C" int native_verified_block_root_authorized(dev_t device)
+{
+  native_ram_verified_root_matches=0;native_ram_verified_wrong_uuid_refused=0;
+  if(device==NODEV || !native_ram_verified_ready || !native_ram_verified_tamper_refused)return 0;
+  OSDictionary *matching=IOService::serviceMatching("IOMedia");
+  OSDictionary *properties=OSDictionary::withCapacity(2);
+  OSNumber *mjr=OSNumber::withNumber(static_cast<unsigned>(major(static_cast<uint32_t>(device))),32);
+  OSNumber *mnr=OSNumber::withNumber(static_cast<unsigned>(minor(static_cast<uint32_t>(device))),32);
+  if(!matching || !properties || !mjr || !mnr){
+    OSSafeReleaseNULL(mnr);OSSafeReleaseNULL(mjr);OSSafeReleaseNULL(properties);OSSafeReleaseNULL(matching);return 0;
+  }
+  bool query=properties->setObject(kIOBSDMajorKey,mjr) && properties->setObject(kIOBSDMinorKey,mnr) &&
+      matching->setObject("IOPropertyMatch",properties);
+  mnr->release();mjr->release();properties->release();
+  OSIterator *iterator=query?IOService::getMatchingServices(matching):nullptr;matching->release();
+  if(!iterator)return 0;
+  bool authenticated=false;unsigned matches=0;
+  while(OSObject *object=iterator->getNextObject()){
+    IOService *media=OSDynamicCast(IOService,object);if(!media)continue;
+    if(++matches!=1){authenticated=false;break;}
+    OSString *uuid=OSDynamicCast(OSString,media->getProperty("UUID"));
+    if(!uuid || uuid->getLength()!=36)continue;
+    unsigned depth=0;
+    for(IOService *provider=media;provider && depth++<64;provider=provider->getProvider()){
+      NativeRamBlock *ram=OSDynamicCast(NativeRamBlock,provider);if(!ram)continue;
+      authenticated=ram->authenticatesVolume(uuid->getCStringNoCopy());
+      char wrong[37];strlcpy(wrong,uuid->getCStringNoCopy(),sizeof(wrong));wrong[0]=wrong[0]=='0'?'1':'0';
+      bool refused=!ram->authenticatesVolume(wrong);
+      native_ram_verified_wrong_uuid_refused=(authenticated && refused)?1:0;
+      authenticated=authenticated && refused;
+      break;
+    }
+  }
+  iterator->release();native_ram_verified_root_matches=matches;
+  return authenticated && matches==1;
+}
