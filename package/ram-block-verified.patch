+// Actual policy/key storage is independently protected read-only, following
+// the canonical VerifiedRoot/VirtioMmioBlock lifetime contract.
+bool NativeRamBlock::configureVerification(uint64_t logical)
+{
+  if(!logical || logical>UINT64_C(0x80000000) || logical%VR_BLOCK_BYTES ||
+     verified_root_manifest_bytes<VR_HEADER_BYTES+VR_SIGNATURE_BYTES ||
+     verified_root_manifest_bytes>UINT64_C(32)*1024*1024)return false;
+  vm_size_t tableBytes=round_page(static_cast<vm_size_t>(verified_root_manifest_bytes));
+  if(tableBytes<verified_root_manifest_bytes || tableBytes>UINT64_MAX-4096)return false;
+  verifiedStorageBytes=tableBytes+4096;
+  if(kmem_alloc(kernel_map,&verifiedStorage,verifiedStorageBytes,
+      static_cast<kma_flags_t>(KMA_KOBJECT|KMA_DATA),VM_KERN_MEMORY_SECURITY)!=KERN_SUCCESS)return false;
+  memcpy(reinterpret_cast<void *>(verifiedStorage),verified_root_manifest,verified_root_manifest_bytes);
+  auto *key=reinterpret_cast<uint8_t *>(verifiedStorage+tableBytes);
+  memcpy(key,verified_root_key,VR_KEY_BYTES);
+  if(vm_map_protect(kernel_map,verifiedStorage,verifiedStorage+verifiedStorageBytes,
+      VM_PROT_READ,TRUE)!=KERN_SUCCESS)return false;
+  if(vr_open(reinterpret_cast<const uint8_t *>(verifiedStorage),verified_root_manifest_bytes,
+      key,1,&vr_xnu_crypto,&verified)!=VR_OK || verified.image_bytes!=logical)return false;
+  verifiedSnapshot=static_cast<uint8_t *>(IOMalloc(VR_BLOCK_BYTES));
+  return verifiedSnapshot!=nullptr;
+}
+
+bool NativeRamBlock::loadVerifiedPage(uint64_t offset,void *target,size_t bytes) const
+{
+  if(!target || offset%VR_BLOCK_BYTES || !bytes || bytes>VR_BLOCK_BYTES ||
+     offset>=capacity*512 || bytes>capacity*512-offset || isBig || direct)return false;
+  if(sparse.pages){
+    const uint8_t *page=sparse.pages[offset/VR_BLOCK_BYTES];
+    if(page)memcpy(target,page,bytes);else bzero(target,bytes);
+  }else if(memory)memcpy(target,memory+offset,bytes);
+  else return false;
+  return true;
+}
+
+bool NativeRamBlock::verificationSelftest()
+{
+  if(!verifiedSnapshot || !loadVerifiedPage(0,verifiedSnapshot,VR_BLOCK_BYTES))return false;
+  if(vr_verify_block(&verified,0,verifiedSnapshot,VR_BLOCK_BYTES,&vr_xnu_crypto)!=VR_OK)return false;
+  verifiedSnapshot[7]^=1; // Isolated private scratch; root seed is never modified.
+  bool refused=vr_verify_block(&verified,0,verifiedSnapshot,VR_BLOCK_BYTES,&vr_xnu_crypto)==VR_BLOCK;
+  verifiedSnapshot[7]^=1;
+  if(!refused || vr_verify_block(&verified,0,verifiedSnapshot,VR_BLOCK_BYTES,&vr_xnu_crypto)!=VR_OK)return false;
+  native_ram_verified_tamper_refused=1;
+  return true;
+}
+
+bool NativeRamBlock::authenticatesVolume(const char *uuid)
+{
+  if(!uuid || strlen(uuid)!=36 || !gate)return false;
+  IOLockLock(gate);
+  bool ready=available() && verifiedStorage && verified.hashes && verifiedSnapshot &&
+      verified.image_bytes==capacity*512 && native_ram_verified_tamper_refused &&
+      !native_ram_verified_integrity_failures && !native_ram_block_failures && !direct;
+  static const char hex[]="0123456789ABCDEF";
+  char expected[37];unsigned at=0;
+  for(unsigned i=0;i<16;++i){
+    if(i==4 || i==6 || i==8 || i==10)expected[at++]='-';
+    expected[at++]=hex[verified.volume_uuid[i]>>4];expected[at++]=hex[verified.volume_uuid[i]&15];
+  }
+  expected[at]=0;
+  bool match=ready && !strcmp(uuid,expected);
+  IOLockUnlock(gate);
+  return match;
+}
